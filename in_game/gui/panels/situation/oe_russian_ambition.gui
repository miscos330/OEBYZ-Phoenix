situation_panel = {
    blockoverride "situation_subheader_content" {}
    blockoverride "situation_panel_main_content" {
        situation_card_expandable = {
            datacontext = "[GetCountry('RUS')]"
            visible = "[Country.IsValid]"
            blockoverride "header_content" {
                country_flag_small_plus = { size = { 50 30 } }
                text_single = { margin_left = 12 text = "[Country.GetName]" }
                expand = {}
            }
            blockoverride "header_button_onclick" { visible = no }
            blockoverride "bottom_content_onclick" { visible = yes }
            blockoverride "bottom_content" {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 18 12 }
                    spacing = 12
                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes text = "oe_ra_country_statistics" }
                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes text = "oe_ra_expansion_explanation" }
                }
            }
        }
    }
}
