# Project Phoenix v45.0 — Native EU5 1.4.9 Interactive Situation Panel: oe_sit_v45_global_silver_flow.
# 100% vanilla widgets, zero custom types, R22/R23/R53 compliant. Generated by gen_v450_world_situations.py.

situation_panel = {
	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text_object" {
				hbox = {
					spacing = 5
					expand = {}
					icon = {
						texture = "gfx/interface/icons/situations/oe_sit_v45_global_silver_flow.dds"
						size = { 30 30 }
					}
					text_single = {
						align = nobaseline
						using = Font_Type_Headers
						using = Font_Size_Big
						maximumsize = { 390 -1 }
						autoresize = yes
						default_format = "#header_titles"
						text = "[SituationView.GetActiveSituation.GetName]"
					}
					expand = {}
				}
			}
		}
	}

	blockoverride "situation_header_left" {
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 14
				default_format = "#subtle_name"
				text = "OE_V45_SILVER_GUI_HDR_ERA"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 14
				default_format = "#yellow_titles"
				raw_text = "1550 - 1700"
			}
		}
		expand = {}
	}

	blockoverride "situation_header_right" {
		expand = {}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = right|nobaseline
				fontsize = 14
				default_format = "#subtle_name"
				text = "OE_V45_SILVER_GUI_HDR_METER"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = right|nobaseline
				fontsize = 14
				default_format = "#yellow_titles"
				raw_text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_v45_silver_index').GetValue|0] / 100"
			}
		}
	}

	blockoverride "situation_panel_image" {
		background = {
			texture = "gfx/interface/illustrations/situation/oe_sit_v45_global_silver_flow.dds"
			spriteType = stretched
		}
		using = scene_fade_vertical_up
	}

	blockoverride "situation_subheader_content" {}

	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_oe_sit_v45_global_silver_flow')]"
		}
	}

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			using = bg_paper_card_situations
			margin = { 12 10 }
			spacing = 8

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				icon = {
					size = { 26 26 }
					texture = "gfx/interface/icons/situations/oe_sit_v45_global_silver_flow.dds"
				}
				text_single = {
					fontsize = 16
					default_format = "#header_titles"
					text = "OE_V45_SILVER_GUI_CARD_TITLE"
				}
				expand = {}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 460
				fontsize = 13
				default_format = "#color_light_gray"
				text = "OE_V45_SILVER_GUI_CARD_BODY"
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 3
				hbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						fontsize = 13
						default_format = "#subtle_name"
						text = "OE_V45_SILVER_GUI_GAUGE_LABEL"
					}
					expand = {}
					text_single = {
						fontsize = 13
						default_format = "#yellow_titles"
						raw_text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_v45_silver_index').GetValue|0] / 100"
					}
				}
				progressbar = {
					layoutpolicy_horizontal = expanding
					size = { -1 12 }
					min = 0
					max = 100
					value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_v45_silver_index').GetValue)]"
					progresstexture = "gfx/interface/progressbars/progress_bar_goldish.dds"
					noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
					texture_density = 2
					spriteType = Corneredstretched
					spriteborder = { 12 0 }
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 460
				fontsize = 13
				default_format = "#color_light_gray"
				text = "OE_V45_SILVER_GUI_FOOTNOTE"
			}
		}
	}
}
