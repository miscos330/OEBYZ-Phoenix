situation_panel = {
    blockoverride "situation_subheader_content" {}
    blockoverride "situation_panel_main_content" {
        text_multi = {
            layoutpolicy_horizontal = expanding
            autoresize = yes
            margin = { 15 10 }
            text = "oe_rus_scoring_explanation"
        }

        situation_card_expandable = {
            datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_rus_first').GetCountry]"
            visible = "[Country.IsValid]"
            blockoverride "header_icon" { country_flag_small_plus = { size = { 50 30 } } }
            blockoverride "header_text" { margin_left = 25 text = "oe_rus_rank_first" }
            blockoverride "header_content_rest" {
                text_single = { text = "[Country.MakeScope.GetVariable('oe_rus_score').GetValue|2]" }
            }
            blockoverride "bottom_content" {
                text_multi = {
                    margin = { 15 5 } layoutpolicy_horizontal = expanding autoresize = yes
                    text = "oe_rus_score_card"
                }
            }
        }

        situation_card_expandable = {
            datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_rus_second').GetCountry]"
            visible = "[Country.IsValid]"
            blockoverride "header_icon" { country_flag_small_plus = { size = { 50 30 } } }
            blockoverride "header_text" { margin_left = 25 text = "oe_rus_rank_second" }
            blockoverride "header_content_rest" {
                text_single = { text = "[Country.MakeScope.GetVariable('oe_rus_score').GetValue|2]" }
            }
            blockoverride "bottom_content" {
                text_multi = {
                    margin = { 15 5 } layoutpolicy_horizontal = expanding autoresize = yes
                    text = "oe_rus_score_card"
                }
            }
        }

        situation_card_expandable = {
            datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('oe_rus_third').GetCountry]"
            visible = "[Country.IsValid]"
            blockoverride "header_icon" { country_flag_small_plus = { size = { 50 30 } } }
            blockoverride "header_text" { margin_left = 25 text = "oe_rus_rank_third" }
            blockoverride "header_content_rest" {
                text_single = { text = "[Country.MakeScope.GetVariable('oe_rus_score').GetValue|2]" }
            }
            blockoverride "bottom_content" {
                text_multi = {
                    margin = { 15 5 } layoutpolicy_horizontal = expanding autoresize = yes
                    text = "oe_rus_score_card"
                }
            }
        }
    }
}
