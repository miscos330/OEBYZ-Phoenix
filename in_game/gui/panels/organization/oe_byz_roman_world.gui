template oe_roman_world_country_grid {
flowcontainer = {
    layoutpolicy_horizontal = expanding
    wrap_count = 3
    ignoreinvisible = yes
    spacing = 8
    datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetMembers]"
    item = {
        widget = {
            size = { 150 96 }
            visible = "[Or(Not(Or(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'byz'), Or(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'beylik'), Or(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'prince'), Or(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'latin_duchy'), InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'orthodox_kingdom')))))), Or(And(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'byz'), Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization, 'oe_byz_roman_world_byz')), Or(And(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'beylik'), Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization, 'oe_byz_roman_world_beylik')), Or(And(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'prince'), Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization, 'oe_byz_roman_world_prince')), Or(And(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'latin_duchy'), Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization, 'oe_byz_roman_world_latin_duchy')), And(InternationalOrganizationsView.Vars.HasValue('oe_roman_world_filter', 'orthodox_kingdom'), Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization, 'oe_byz_roman_world_orthodox_kingdom')))))))]"
            using = bg_paper_card
            using = bg_cabinet_card_frame
            vbox = {
                size = { 100% 100% }
                margin = { 6 7 }
                spacing = 4
                hbox = {
                    layoutpolicy_horizontal = expanding
                    expand = {}
                    country_flag_small_plus = { size = { 40 30 } }
                    expand = {}
                }
                text_single = {
                    layoutpolicy_horizontal = expanding
                    maximumsize = { 138 24 }
                    fontsize = 17
                    text = "[Country.GetNameWithNoTooltip]"
                    tooltip = "[Country.GetName]"
                }
                text_single = {
                    layoutpolicy_horizontal = expanding
                    maximumsize = { 138 22 }
                    fontsize = 15
                    text = "[Country.GetCapital.GetName]"
                }
            }
        }
    }
}
}

