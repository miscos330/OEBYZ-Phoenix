# The HRE's card decoration and native country flags, with a local filter variable.
# Do not call HRE-only rank-filter APIs for this organization.
organization_panel = {
    blockoverride "abilities_widget" {}
    blockoverride "organization_art_header" {
        widget = {
            layoutpolicy_horizontal = expanding
            size = { -1 220 }
            icon = {
                size = { 100% 100% }
                texture = "[InternationalOrganizationsView.GetIllustration]"
                texture_density = 2
                spriteType = stretched
                spriteborder = { 0 0 }
            }
        }
    }

    blockoverride "country_header_character_visible" { visible = no }
    blockoverride "organization_overview_filtered_list" {
        scrollarea = {
            using = layoutpolicy_expanding
            scrollbarpolicy_horizontal = always_off
            scrollbar_vertical = { using = Scrollbar_Vertical }
            scrollwidget = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 12 12 }
                    spacing = 12
                    card_common = {
                    blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                    blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                    blockoverride "common_header_text_full" { text_single = { text = "OE_ROMAN_WORLD_SHARED_HERITAGE" fontsize = 20 } }
                    blockoverride "common_bottom_content" {
                        text_single = {
                            margin = { 12 10 }
                            layoutpolicy_horizontal = expanding
                            multiline = yes
                            autoresize = yes
                            fontsize = 17
                            text = "OE_ROMAN_WORLD_OVERVIEW"
                        }
                    }
                }
                    # Restoration belongs to the overview, above cultural assimilation.
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        datamodel = "[InternationalOrganizationsView.GetActions]"
                        item = {
                            widget = {
                                visible = "[EqualTo_string(GenericAction.GetKey, 'oe_end')]"
                                layoutpolicy_horizontal = expanding
                                size = { -1 56 }
                                using = bg_paper_card
                                using = bg_cabinet_card_frame
                                button_regular_diamond = {
                                    parentanchor = center
                                    size = { 390 40 }
                                    fontsize = 18
                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                    scripted_action_tooltip = {
                                        click_type = left
                                        click_mode = single
                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                        action_name = "[GenericAction.GetKey]"
                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                    }
                                }
                            }
                        }
                    }
                    oe_rw_assimilation_panel = {}
                }
            }
        }
    }
    blockoverride "organization_panel_members_area" {
        # NEW r6 a-ui: 授予尊号 sits above the roster, next to each ruler's rank and dignity.
        vbox = {
            using = layoutpolicy_expanding
            spacing = 6
            oe_r6_grant_title_bar = {}
            vbox = { using = oe_roman_world_roster }
        }
    }

    blockoverride "io_overview_actions" {}
    blockoverride "organization_custom_tabs" {
        button_secondary_tab_alt = {
            using = layoutpolicy_expanding
            visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_rw_contest_ended').IsSet)]"
            blockoverride "tab_text" { text = "OE_ROMAN_CONTEST_TAB" }
            tooltip = "OE_ROMAN_CONTEST_RULES"
            onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_roman_contest')]"
            down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_roman_contest')]"
        }
        button_secondary_tab_alt = {
            using = layoutpolicy_expanding
            visible = "[GetScriptedGui('oe_rw_hegemony_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
            blockoverride "tab_text" { text = "OE_RW_HEGEMONY_TAB" }
            tooltip = "OE_RW_HEGEMONY_DESC"
            onclick = "[InternationalOrganizationsView.Vars.Set('organizations','oe_hegemony')]"
            down = "[Or(InternationalOrganizationsView.Vars.HasValue('organizations','oe_hegemony'),And(InternationalOrganizationsView.Vars.HasValue('organizations','oe_roman_contest'),InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_rw_contest_ended').IsSet))]"
        }
        button_secondary_tab_alt = {
        using = layoutpolicy_expanding
        visible = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        blockoverride "tab_text" { text = "OE_CITY_TAB" }
        tooltip = "OE_CITY_TAB_DESC"
        onclick = "[GetScriptedGui('oe_city_refresh_on_open').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        onclick = "[InternationalOrganizationsView.Vars.Set('organizations','oe_constantinople')]"
        down = "[InternationalOrganizationsView.Vars.HasValue('organizations','oe_constantinople')]"
    }
        button_secondary_tab_alt = {
            using = layoutpolicy_expanding
            blockoverride "tab_text" { text = "OE_WORKS_TAB" }
            tooltip = "OE_WORKS_TAB_DESC"
            onclick = "[InternationalOrganizationsView.Vars.Set('organizations','oe_imperial_works')]"
            down = "[InternationalOrganizationsView.Vars.HasValue('organizations','oe_imperial_works')]"
        }
    }
    blockoverride "organization_custom_contents" {
        scrollarea = {
            using = layoutpolicy_expanding
            visible = "[And(Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_rw_contest_ended').IsSet),InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_roman_contest'))]"
            scrollbarpolicy_horizontal = always_off
            scrollbar_vertical = { using = Scrollbar_Vertical }
            scrollwidget = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 12 12 }
                    spacing = 14
                    card_common = {
                        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                        blockoverride "common_header_text_full" { text_single = { text = "OE_ROMAN_CONTEST_LEADERS" fontsize = 20 } }
                        blockoverride "common_bottom_content" {
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 10 12 }
                                spacing = 14
                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    widget = {
                                        layoutpolicy_horizontal = expanding
                                        size = { -1 156 }
                                        using = bg_paper_card
                                        using = bg_cabinet_card_frame
                                        vbox = {
                                            size = { 100% 100% }
                                            margin = { 6 8 }
                                            spacing = 7
                                            text_single = { layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_RANK_1" }
                                            vbox = {
                                                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_1').GetCountry]"
                                                visible = "[Country.IsValid]"
                                                layoutpolicy_horizontal = expanding
                                                spacing = 6
                                                hbox = { layoutpolicy_horizontal = expanding expand = {} country_flag_small_plus = { size = { 50 36 } } expand = {} }
                                                text_single = { layoutpolicy_horizontal = expanding maximumsize = { 132 24 } fontsize = 17 text = "[Country.GetNameWithNoTooltip]" tooltip = "[Country.GetName]" }
                                                text_single = { layoutpolicy_horizontal = expanding fontsize = 24 text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('oe_roman_world_contest_score')|1]" tooltip = "OE_ROMAN_CONTEST_SCORE_BREAKDOWN" }
                                            }
                                            text_single = { visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_1').GetCountry.IsValid)]" layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_VACANT" }
                                        }
                                    }
                                    widget = {
                                        layoutpolicy_horizontal = expanding
                                        size = { -1 156 }
                                        using = bg_paper_card
                                        using = bg_cabinet_card_frame
                                        vbox = {
                                            size = { 100% 100% }
                                            margin = { 6 8 }
                                            spacing = 7
                                            text_single = { layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_RANK_2" }
                                            vbox = {
                                                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_2').GetCountry]"
                                                visible = "[Country.IsValid]"
                                                layoutpolicy_horizontal = expanding
                                                spacing = 6
                                                hbox = { layoutpolicy_horizontal = expanding expand = {} country_flag_small_plus = { size = { 50 36 } } expand = {} }
                                                text_single = { layoutpolicy_horizontal = expanding maximumsize = { 132 24 } fontsize = 17 text = "[Country.GetNameWithNoTooltip]" tooltip = "[Country.GetName]" }
                                                text_single = { layoutpolicy_horizontal = expanding fontsize = 24 text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('oe_roman_world_contest_score')|1]" tooltip = "OE_ROMAN_CONTEST_SCORE_BREAKDOWN" }
                                            }
                                            text_single = { visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_2').GetCountry.IsValid)]" layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_VACANT" }
                                        }
                                    }
                                    widget = {
                                        layoutpolicy_horizontal = expanding
                                        size = { -1 156 }
                                        using = bg_paper_card
                                        using = bg_cabinet_card_frame
                                        vbox = {
                                            size = { 100% 100% }
                                            margin = { 6 8 }
                                            spacing = 7
                                            text_single = { layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_RANK_3" }
                                            vbox = {
                                                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_3').GetCountry]"
                                                visible = "[Country.IsValid]"
                                                layoutpolicy_horizontal = expanding
                                                spacing = 6
                                                hbox = { layoutpolicy_horizontal = expanding expand = {} country_flag_small_plus = { size = { 50 36 } } expand = {} }
                                                text_single = { layoutpolicy_horizontal = expanding maximumsize = { 132 24 } fontsize = 17 text = "[Country.GetNameWithNoTooltip]" tooltip = "[Country.GetName]" }
                                                text_single = { layoutpolicy_horizontal = expanding fontsize = 24 text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('oe_roman_world_contest_score')|1]" tooltip = "OE_ROMAN_CONTEST_SCORE_BREAKDOWN" }
                                            }
                                            text_single = { visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_roman_contest_rank_3').GetCountry.IsValid)]" layoutpolicy_horizontal = expanding fontsize = 18 text = "OE_ROMAN_CONTEST_VACANT" }
                                        }
                                    }
                                }
                                text_single = { layoutpolicy_horizontal = expanding fontsize = 20 text = "OE_ROMAN_CONTEST_QUOTE" align = left }
                                text_single = { layoutpolicy_horizontal = expanding fontsize = 17 text = "OE_ROMAN_CONTEST_QUOTE_SOURCE" align = right }
                            }
                        }
                    }
                    
                    card_common = {
                        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                        blockoverride "common_header_text_full" { text_single = { text = "OE_ROMAN_CONTEST_ACTIONS" fontsize = 20 } }
                        blockoverride "common_bottom_content" {
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 12 12 }
                                datamodel = "[InternationalOrganizationsView.GetActions]"
                                item = {
                                    widget = {
                                        visible = "[Or(Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_divide_bulgaria_serbia'), EqualTo_string(GenericAction.GetKey, 'oe_rw_found_moldavian_governorate')),Or(Or(EqualTo_string(GenericAction.GetKey, 'oe_guarantee_cilicia'), EqualTo_string(GenericAction.GetKey, 'oe_cilicia_protectorate')),Or(EqualTo_string(GenericAction.GetKey, 'oe_byz_press_claims'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_recruit_turkic_mercenaries'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_classical_revival'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_recognize_local_rule'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_mobilize_border'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_latin_instructors_action'), Or(EqualTo_string(GenericAction.GetKey, 'oe_rw_study_roman_tactics'), EqualTo_string(GenericAction.GetKey, 'oe_rw_challenge_empire'))))))))))]"
                                        layoutpolicy_horizontal = expanding
                                        size = { -1 56 }
                                        using = bg_paper_card
                                        using = bg_cabinet_card_frame
                                        button_regular_diamond = {
                                            parentanchor = center
                                            size = { 390 40 }
                                            fontsize = 18
                                            text = "[GenericAction.GetNameWithNoTooltip]"
                                            tooltipwidget = { using = io_generic_action_button_tooltip }
                                            visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                            scripted_action_tooltip = {
                                                click_type = left
                                                click_mode = single
                                                actor = "[InternationalOrganizationsView.GetPlayer]"
                                                action_name = "[GenericAction.GetKey]"
                                                parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                
                    # NEW r6 a-ui: tribute actions while the contest lasts (the hegemony page has the same card).
                    oe_r6_tribute_card = {}
                    card_common = {
                        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                        blockoverride "common_header_text_full" { text_single = { text = "OE_RW_END_CONTEST_HEADER" fontsize = 20 } }
                        blockoverride "common_bottom_content" {
                            vbox = {
                                layoutpolicy_horizontal = expanding margin = { 12 12 } spacing = 10
                                text_single = { text = "OE_RW_HEGEMONY_PROGRESS" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding tooltip = "OE_RW_HEGEMONY_COUNT_RULES" }
                                widget = {
                                    layoutpolicy_horizontal = expanding size = { -1 48 }
                                    datacontext = "[GetGenericAction('oe_rw_end_contest')]"
                                    button_regular_diamond = {
                                        parentanchor = center
                                        size = { 390 40 }
                                        fontsize = 18
                                        text = "[GenericAction.GetNameWithNoTooltip]"
                                        tooltipwidget = { using = io_generic_action_button_tooltip }
                                        visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                        enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                        scripted_action_tooltip = {
                                            click_type = left
                                            click_mode = single
                                            actor = "[InternationalOrganizationsView.GetPlayer]"
                                            action_name = "[GenericAction.GetKey]"
                                            parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                        }
                                    }
                                }
                            }
                        }
                    }
}
            }
        }
    
scrollarea = {
        using = layoutpolicy_expanding
        visible = "[And(GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End),InternationalOrganizationsView.Vars.HasValue('organizations','oe_constantinople'))]"
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
        scrollwidget = {
            vbox = {
                layoutpolicy_horizontal = expanding margin = { 10 10 } spacing = 8
                text_single = { text = "OE_CITY_OWNER" fontsize = 17 }
                text_single = { text = "OE_CITY_MAP_HINT" fontsize = 17 }
                text_single = { text = "OE_CITY_QUEUE_STATUS" fontsize = 16 }
                widget = {
                    layoutpolicy_horizontal = expanding size = { -1 420 }
                    background = { texture = "gfx/interface/illustrations/international_organization_types/oe_constantinople_plan.dds" spriteType = stretched }
                    # Invisible hit rectangle: walls. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_walls"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 9% 37% } size = { 14% 50% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_WALLS"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','walls')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: blachernae. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_blachernae"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 20% 7% } size = { 18% 22% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_BLACHERNAE"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','blachernae')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: apostles. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_apostles"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 39% 32% } size = { 19% 20% }
                        alwaystransparent = no
