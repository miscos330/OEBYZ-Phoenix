                        tooltip = "OE_CITY_APOSTLES"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','apostles')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: mese. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_mese"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 32% 54% } size = { 24% 23% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_MESE"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','mese')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: east. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_east"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 65% 36% } size = { 28% 26% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_EAST"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','east')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: horn. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_horn"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 40% 18% } size = { 24% 13% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_HORN"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','horn')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
# Invisible hit rectangle: south. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_south"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 58% 64% } size = { 26% 16% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_SOUTH"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','south')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
                    # Invisible hit rectangle: north. The background and all hit areas use this same map widget.
                    button = {
                        name = "oe_city_hit_north"
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 58% 3% } size = { 26% 14% }
                        alwaystransparent = no
                        enabled = "[GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltip = "OE_CITY_NORTH"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','north')]"
                        onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','none')]"
                    }
widget = {
                        ignore_layout = yes
                        parentanchor = left|top widgetanchor = left|top
                        position = { 3% 4% } size = { 94% 92% }
                        visible = "[And(GetScriptedGui('oe_city_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'walls'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'blachernae'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'apostles'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'mese'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'east'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'horn'),Or(InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'south'),InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'north')))))))))]"
                        widget = {
        size = { 100% 100% }
        visible = "[InternationalOrganizationsView.Vars.HasValue('oe_city_district', 'walls')]"
        using = bg_paper_card using = bg_cabinet_card_frame
        vbox = {
            size = { 100% 100% } margin = { 14 12 } spacing = 8
            hbox = {
                layoutpolicy_horizontal = expanding
                text_single = { text = "OE_CITY_WALLS" fontsize = 21 }
                expand = {}
                button_regular = { size = { 64 30 } text = "OE_CITY_CLOSE" tooltip = "OE_CITY_CLOSE" onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_district','none')]" }
            }
            text_single = { text = "OE_CITY_WALLS_DESC" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
            scrollarea = {
                using = layoutpolicy_expanding scrollbarpolicy_horizontal = always_off
                scrollbar_vertical = { using = Scrollbar_Vertical }
                scrollwidget = {
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 7
                        text_single = { text = "OE_CITY_BUILT" fontsize = 18 }
                        vbox = {
                            layoutpolicy_horizontal = expanding spacing = 5
                            datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetList('oe_city_walls_types')]" item = { widget = {
    datacontext = "[Scope.GetBuildingType]"
    layoutpolicy_horizontal = expanding size = { -1 48 }
    using = bg_paper_card using = bg_cabinet_card_frame
    visible = "[GetScriptedGui('oe_city_has_building').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).AddScope('city_building_type',BuildingType.MakeScope).End)]"
    hbox = {
        size = { 100% 100% } margin = { 8 6 } spacing = 8
        icon = { size = { 30 30 } texture = "[GetBuildingIcon(BuildingType.Self)]" tooltipwidget = { using = BuildingType_tooltip } }
        text_single = { text = "[BuildingType.GetNameWithNoTooltip]" fontsize = 16 layoutpolicy_horizontal = expanding autoresize = yes multiline = yes tooltipwidget = { using = BuildingType_tooltip } }
        text_single = { text = "OE_CITY_LEVELS" fontsize = 16 }
    }
} }
                        }
                        button_regular = {
                            tooltip = "OE_CITY_ADD"
                            layoutpolicy_horizontal = expanding size = { -1 34 }
                            text = "OE_CITY_ADD"
                            visible = "[GetScriptedGui('oe_city_district_projects_walls').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            onclick = "[GetScriptedGui('oe_city_refresh_on_open').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            onclick = "[InternationalOrganizationsView.Vars.Set('oe_city_catalog','walls')]"
                        }
                        vbox = {
                            layoutpolicy_horizontal = expanding spacing = 6
                            visible = "[InternationalOrganizationsView.Vars.HasValue('oe_city_catalog','walls')]"
                            text_single = { text = "OE_CITY_BUILDABLE" fontsize = 18 }
                            vbox = {
                                layoutpolicy_horizontal = expanding spacing = 5
                                datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetList('oe_city_walls_types')]" item = { widget = {
        datacontext = "[Scope.GetBuildingType]"
