# Inspired by the HRE's status headers and grouped shields; uses ordinary
# Country data, so no emperor/elector-only bindings are carried into this IO.
template oe_pillars_member_cards {
    card_common = {
        margin = { 8 4 }
        blockoverride "header_decor_templates" {
            using = bg_card_header_01_hre
            using = bg_cabinet_card_frame
        }
        blockoverride "common_header_icon_texture" {
            texture = "[MemberTypeItem.GetIcon]"
            texture_density = 2
        }
        blockoverride "common_header_text_full" {
            text_single = {
                raw_text = "[MemberTypeItem.GetName]  ·  [MemberTypeItem.GetMembersAmount]"
                fontsize = 17
            }
        }
        blockoverride "header_size" { size = { -1 38 } }
        blockoverride "common_bottom_content" {
            using = oe_pillars_member_shields
        }
    }
}

# Synchronized native slider, exclusively available to the imperial payer BYZ.
# Authority expenditure is shown from the same script value used at settlement.
types oe_pillars_finance_widgets {
    type oe_pillars_authority_investment = vbox {
        layoutpolicy_horizontal = expanding
        # Keep the outer custom type content-sized, like the verified diagnostic.
        # The list lives in a child container, and each row sizes from its content.
        vbox = {
            layoutpolicy_horizontal = expanding
            # Edit the player's payment maintenance, which the purse settlement reads.
            datacontext = "[GetEconomyView]"
            datamodel = "[EconomyView.GetMaintenanceSettings]"
            item = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    minimumsize = { -1 182 }
                    margin = { 12 8 }
                    spacing = 8
                    using = bg_paper_card
                    using = bg_cabinet_card_frame
                    visible = "[EqualTo_string(MaintenanceSetting.GetNameWithNoTooltip, Localize('oe_pillars_authority_budget'))]"
                    tooltip = "oe_pillars_authority_budget_desc"
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        expand = {}
                        icon = { size = { 19 19 } texture = "gfx/interface/icons/international_organizations/oe_pillars_authority.dds" }
                        text_single = { text = "oe_pillars_authority_budget" fontsize = 18 }
                        expand = {}
                    }
                    text_single = {
                        text = "OE_PILLARS_AUTHORITY_PREVIEW"
                        multiline = yes
                        autoresize = yes
                        layoutpolicy_horizontal = expanding
                        align = center
                        fontsize = 16
                    }
                    # Give the track and its +/- buttons a real layout footprint.
                    widget = {
                        layoutpolicy_horizontal = expanding
                        layoutpolicy_vertical = fixed
                        size = { -1 40 }
                        minimumsize = { -1 40 }
                        allow_outside = yes
                        economy_slider = {
                            parentanchor = center
                            widgetanchor = center
                            size = { 350 10 }
                            min = 0
                            max = 1
                            value = "[MaintenanceSetting.GetDefault]"
                            # This zero-price setting controls scripted IO spending.
                            # Native expense eligibility/caps must not lock the custom budget.
                            mincap = 0
                            maxcap = 1
                            onvaluechanged = "[MaintenanceSetting.OnChanged]"
                            onchangefinish = "[MaintenanceSetting.Post]"
                            enabled = "[EqualTo_string(InternationalOrganizationsView.GetPlayer.GetTag, 'BYZ')]"
                            blockoverride "economy_slider_inc_button_config" { enabled = "[EqualTo_string(InternationalOrganizationsView.GetPlayer.GetTag, 'BYZ')]" }
                            blockoverride "economy_slider_dec_button_config" { enabled = "[EqualTo_string(InternationalOrganizationsView.GetPlayer.GetTag, 'BYZ')]" }
                        }
                    }
                    text_single = {
                        layoutpolicy_horizontal = expanding
                        multiline = yes
                        autoresize = yes
                        text = "OE_PILLARS_AUTHORITY_BUDGET_HINT"
                        fontsize = 16
                    }
                }
            }
        }
    }
}

