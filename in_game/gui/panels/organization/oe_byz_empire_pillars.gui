    blockoverride "organization_treasury_tab_visible" { visible = no }
    blockoverride "organization_treasury_content_visible" { visible = no }
    blockoverride "organization_laws_tab_visible" { visible = no }
    blockoverride "organization_custom_tab_visible" { visible = yes }
    blockoverride "organization_custom_tab_text" { text = "OE_PILLARS_TRANSFERS" }
    blockoverride "organization_custom_tab_tooltip" { tooltip = "OE_PILLARS_TRANSFERS_DESC" }
    blockoverride "organization_custom_content_visible" {
        visible = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'custom')]"
    }
    blockoverride "organization_custom_content" {
        scrollarea = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            scrollbarpolicy_horizontal = always_off
            scrollbar_vertical = { using = Scrollbar_Vertical }
            scrollwidget = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 8 }
                    spacing = 10
                    text_single = { text = "OE_PILLARS_TRANSFERS_DESC" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                    card_common = {
        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_empire_pillars.dds" }
