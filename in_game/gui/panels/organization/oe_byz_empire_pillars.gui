        size = { -1 62 }
        using = bg_paper_card
        using = bg_cabinet_card_frame
        datacontext = "[GetGenericAction('oe_ir_guilds')]"
        hbox = {
            size = { 100% 100% } margin = { 10 9 } spacing = 12
            widget = {
                size = { 32 32 }
                tooltip = "[SelectLocalization(GetCountry('BYZ').MakeScope.GetVariable('oe_ir_guilds_done').IsSet, 'OE_IR_COMPLETE', 'OE_IR_PENDING')]"
                icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_bg_square.dds" }
                icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_frame_square.dds" }
                icon = {
                    size = { 28 28 } parentanchor = center widgetanchor = center
                    texture = "gfx/interface/icons/diplomatic_status/tick_accept.dds"
                    visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_ir_guilds_done').IsSet]"
                }
            }
            button_regular_diamond = {
                size = { -1 42 }
                layoutpolicy_horizontal = expanding
                fontsize = 18
                text = "[GenericAction.GetNameWithNoTooltip]"
                tooltipwidget = { using = io_generic_action_button_tooltip }
                visible = "[PdxGuiWidget.IsUberButtonVisible]"
                enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                scripted_action_tooltip = {
                    click_type = left
                    click_mode = single
                    actor = "[InternationalOrganizationsView.GetPlayer]"
                    action_name = "[GenericAction.GetKey]"
                    parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                }
            }
        }
    }
