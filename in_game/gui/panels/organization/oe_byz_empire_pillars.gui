# Local IO theme. Native court relocation uses a separate BYZ-only economy visibility guard.
organization_panel = {
    blockoverride "abilities_widget" {}
    blockoverride "country_header_character_visible" { visible = no }
    blockoverride "io_overview_actions" {}
    blockoverride "organization_overview_payments" {}
    blockoverride "organization_custom_tabs" {
        button_secondary_tab_alt = {
            using = layoutpolicy_expanding
            blockoverride "tab_text" { text = "OE_PILLARS_EDICTS" }
            tooltip = "OE_PILLARS_EDICTS_DESC"
            onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_edicts')]"
            onclick = "[InternationalOrganizationsView.Vars.Set('oe_nf_open_family', '')]"
            onclick = "[GetScriptedGui('oe_nf_clear_territory_focus').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
            down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_edicts')]"
        }
    
button_secondary_tab_alt = {
        using = layoutpolicy_expanding
        blockoverride "tab_text" { text = "OE_CHR_TAB_REFORMS" }
        tooltip = "OE_PILLARS_REFORMS_DESC"
        onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_reforms')]"
            onclick = "[InternationalOrganizationsView.Vars.Set('oe_nf_open_family', '')]"
            onclick = "[GetScriptedGui('oe_nf_clear_territory_focus').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_reforms')]"
    }
    # NEW 2026-11-17 theme-rework UI-1: 军区 tab (page body in gui/shared/oe_theme_ui.gui).
    button_secondary_tab_alt = {
        using = layoutpolicy_expanding
        blockoverride "tab_text" { text = "OE_PILLARS_THEMES" }
        tooltip = "OE_PILLARS_THEMES_DESC"
        onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_themes')]"
        onclick = "[InternationalOrganizationsView.Vars.Set('oe_nf_open_family', '')]"
        onclick = "[GetScriptedGui('oe_nf_clear_territory_focus').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_themes')]"
    }
    # NEW 2026-11-18 territory rework UI: 附庸 tab (page body in gui/shared/oe_vassal_ui.gui, gen_territory_ui.py).
    button_secondary_tab_alt = {
        using = layoutpolicy_expanding
        blockoverride "tab_text" { text = "OE_PILLARS_VASSALS" }
        tooltip = "OE_PILLARS_VASSALS_DESC"
        onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_vassals')]"
        onclick = "[InternationalOrganizationsView.Vars.Set('oe_nf_open_family', '')]"
        onclick = "[GetScriptedGui('oe_nf_clear_territory_focus').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_vassals')]"
    }
    # NEW 2026-11-19 r7 F3: 编年史 tab (page body in gui/shared/oe_chronicle_ui.gui, gen_chronicle.py).
    button_secondary_tab_alt = {
        using = layoutpolicy_expanding
        blockoverride "tab_text" { text = "OE_CHR_TAB" }
        tooltip = "OE_CHR_TAB_DESC"
        onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_chronicle')]"
        onclick = "[InternationalOrganizationsView.Vars.Set('oe_nf_open_family', '')]"
        onclick = "[GetScriptedGui('oe_nf_clear_territory_focus').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_chronicle')]"
    }

        
}
    blockoverride "organization_custom_tabs_right" {
        button_secondary_tab_alt = {
            using = layoutpolicy_expanding
            visible = "[GetScriptedGui('oe_court_page_visible').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
            blockoverride "tab_text" { text = "OE_COURT_TITLE" }
            tooltip = "OE_COURT_DESC"
            onclick = "[GetScriptedGui('oe_nf_refresh_on_open').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
            onclick = "[InternationalOrganizationsView.Vars.Set('organizations', 'oe_court')]"
            down = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_court')]"
        }
    }
    blockoverride "organization_custom_contents" {
        scrollarea = {
            using = layoutpolicy_expanding
            visible = "[InternationalOrganizationsView.Vars.HasValue('organizations', 'oe_edicts')]"
            scrollbarpolicy_horizontal = always_off
            scrollbar_vertical = { using = Scrollbar_Vertical }
            scrollwidget = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 16 12 }
                    spacing = 14
                    
                    card_common = {
        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_empire_pillars.dds" }
        blockoverride "common_header_text_full" { text_single = { text = "OE_PILLARS_MILITARY_EDICTS" fontsize = 20 } }
        blockoverride "common_bottom_content" {
            vbox = {
                layoutpolicy_horizontal = expanding margin = { 12 12 } spacing = 12
                
                # NEW r6 a-ui: fold group mil_found (open by default).
                vbox = {
                    layoutpolicy_horizontal = expanding spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        widget = {
                            size = { 28 34 }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_found')]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_found')]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_found'))]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_found')]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 34 }
                            blockoverride "tab_text" { text = "OE_R6_GRP_MIL_FOUND" fontsize = 16 }
                            tooltip = "OE_R6_FOLD_TT"
                            onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_found')]"
                            down = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_found'))]"
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 10
                        visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_found'))]"
                        datamodel = "[InternationalOrganizationsView.GetActions]"
                        item = {
                            widget = {
                                visible = "[Or(EqualTo_string(GenericAction.GetKey, 'oe_theme_found_all_action'),Or(EqualTo_string(GenericAction.GetKey, 'oe_create_theme'),Or(EqualTo_string(GenericAction.GetKey, 'oe_create_theme_in_italy'),Or(EqualTo_string(GenericAction.GetKey, 'oe_theme_move_seat_action'),EqualTo_string(GenericAction.GetKey, 'oe_pillars_convert_theme_type')))))]"
                                using = oe_edict_card
                            }
                        }
                    }
                }
                # NEW r6 a-ui: fold group mil_manage (open by default).
                vbox = {
                    layoutpolicy_horizontal = expanding spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        widget = {
                            size = { 28 34 }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_manage')]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_manage')]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_manage'))]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_manage')]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 34 }
                            blockoverride "tab_text" { text = "OE_R6_GRP_MIL_MANAGE" fontsize = 16 }
                            tooltip = "OE_R6_FOLD_TT"
                            onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_manage')]"
                            down = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_manage'))]"
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 10
                        visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_manage'))]"
                        datamodel = "[InternationalOrganizationsView.GetActions]"
                        item = {
                            widget = {
                                visible = "[Or(EqualTo_string(GenericAction.GetKey, 'oe_theme_set_focus'),Or(EqualTo_string(GenericAction.GetKey, 'oe_theme_set_officials'),Or(EqualTo_string(GenericAction.GetKey, 'oe_theme_order_works'),Or(EqualTo_string(GenericAction.GetKey, 'oe_pillars_reinforce_theme'),EqualTo_string(GenericAction.GetKey, 'oe_pillars_enact_rum_pronoia')))))]"
                                using = oe_edict_card
                            }
                        }
                    }
                }
                # NEW r6 a-ui: fold group mil_border (open by default).
                vbox = {
                    layoutpolicy_horizontal = expanding spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        widget = {
                            size = { 28 34 }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_border')]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_border')]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_border'))]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_border')]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 34 }
                            blockoverride "tab_text" { text = "OE_R6_GRP_MIL_BORDER" fontsize = 16 }
                            tooltip = "OE_R6_FOLD_TT"
                            onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_fold_mil_border')]"
                            down = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_border'))]"
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 10
                        visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_fold_mil_border'))]"
                        datamodel = "[InternationalOrganizationsView.GetActions]"
                        item = {
                            widget = {
                                visible = "[Or(EqualTo_string(GenericAction.GetKey, 'oe_ti_settle_soldiers'),Or(EqualTo_string(GenericAction.GetKey, 'oe_col_resettle'),Or(EqualTo_string(GenericAction.GetKey, 'oe_tbd_fortify'),Or(EqualTo_string(GenericAction.GetKey, 'oe_tbd_levy'),Or(EqualTo_string(GenericAction.GetKey, 'oe_tbd_hire'),EqualTo_string(GenericAction.GetKey, 'oe_byz_empire_org_action_create_pronia_infastry'))))))]"
                                using = oe_edict_card
                            }
                        }
                    }
                }
                # NEW r6 a-ui: fold group mil_curb (closed by default).
                vbox = {
                    layoutpolicy_horizontal = expanding spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        widget = {
                            size = { 28 34 }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[Not(InternationalOrganizationsView.Vars.Exists('oe_r6_open_mil_curb'))]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_open_mil_curb')]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_open_mil_curb')]"
                                onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_open_mil_curb')]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                using = button_regular_icon_color
                                tooltip = "OE_R6_FOLD_TT"
                            }
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 34 }
                            blockoverride "tab_text" { text = "OE_R6_GRP_MIL_CURB" fontsize = 16 }
                            tooltip = "OE_R6_FOLD_TT"
                            onclick = "[InternationalOrganizationsView.Vars.Toggle('oe_r6_open_mil_curb')]"
                            down = "[InternationalOrganizationsView.Vars.Exists('oe_r6_open_mil_curb')]"
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 10
                        visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_open_mil_curb')]"
                        datamodel = "[InternationalOrganizationsView.GetActions]"
                        item = {
                            widget = {
                                visible = "[Or(EqualTo_string(GenericAction.GetKey, 'oe_byz_empire_org_action_abolish_ruler'),Or(EqualTo_string(GenericAction.GetKey, 'oe_byz_empire_org_action_abolish_army'),EqualTo_string(GenericAction.GetKey, 'oe_byz_empire_org_action_abolish_theme')))]"
                                using = oe_edict_card
                            }
                        }
                    }
                }
            }
        }
    }
