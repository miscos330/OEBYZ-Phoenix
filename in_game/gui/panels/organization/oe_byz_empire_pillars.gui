        blockoverride "common_bottom_content" {
            vbox = { layoutpolicy_horizontal = expanding margin = { 10 10 } spacing = 10
            text_single = { text = "OE_PILLARS_PURSE_INCOME" fontsize = 17 }
oe_pillars_payment_ledger = {}
            }
        }
    }
