card_common = {
        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_pillars_authority.dds" }
        blockoverride "common_header_text_full" { text_single = { text = "OE_PILLARS_CIVIL_EDICTS" fontsize = 20 } }
        blockoverride "common_bottom_content" {
            vbox = {
                layoutpolicy_horizontal = expanding margin = { 12 12 } spacing = 12

                # Territory exchange disabled at user request (2026-11-01).
                
                # NEW r6 a-ui: fold group civ_crown (open by default).
                vbox = {
                    layoutpolicy_horizontal = expanding spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        widget = {
                            size = { 28 34 }
                            button = {
                                size = { 24 24 } parentanchor = center
                                visible = "[InternationalOrganizationsView.Vars.Exists('oe_r6_fold_civ_crown')]"
