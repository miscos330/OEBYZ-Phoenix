# The original native court maintenance setting; no scripted price or benefit.
types oe_pillars_finance_pages {
    type oe_pillars_native_court = vbox {
        layoutpolicy_horizontal = expanding
        visible = "[GetScriptedGui('oe_pillars_uses_moved_court').IsShown(GuiScope.SetRoot(Player.MakeScope).End)]"
        datacontext = "[GetEconomyView]"
        datamodel = "[EconomyView.GetMaintenanceSettings]"
        item = {
            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 182 }
                visible = "[EqualTo_string(MaintenanceSetting.GetNameWithNoTooltip,Localize('CourtMaintenance_eco_view_no_tt'))]"
                using = bg_paper_card
                using = bg_cabinet_card_frame
                vbox = {
                    size = { 100% 100% }
                    layoutpolicy_horizontal = expanding
                    margin = { 12 8 }
                    spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 8
                        icon = { size = { 24 24 } texture = "[MaintenanceSetting.GetIcon]" }
                        text_single = { text = "[MaintenanceSetting.GetName]" fontsize = 17 }
                        expand = {}
                        text_single = { raw_text = "[MaintenanceSetting.GetExpenseWithCurrency]" }
                        tooltipwidget = { using = ExpenseSettingTooltip }
                    }
                    economy_slider = {
                        size = { 350 10 }
                        min = 0
                        max = 1
                        value = "[MaintenanceSetting.GetDefault]"
                        mincap = "[MaintenanceSetting.GetMin]"
                        maxcap = "[MaintenanceSetting.GetMax]"
                        onvaluechanged = "[MaintenanceSetting.OnChanged]"
                        onchangefinish = "[MaintenanceSetting.Post]"
                        enabled = "[And(MaintenanceSetting.IsEnabled,Not(IsPlayerAIEnabled('finances')))]"
                        blockoverride "economy_slider_inc_button_config" { enabled = "[MaintenanceSetting.IsIncEnabled]" }
                        blockoverride "economy_slider_dec_button_config" { enabled = "[MaintenanceSetting.IsDecEnabled]" }
                    }
                    text_single = { text = "[MaintenanceSetting.GetExpenseBenefit]" fontsize = 16 }
                    text_single = { text = "OE_PILLARS_NATIVE_COURT_HINT" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                }
            }
        }
    }
    type oe_pillars_native_bureaucracy = vbox {
        layoutpolicy_horizontal = expanding
        visible = "[GetScriptedGui('oe_pillars_uses_moved_court').IsShown(GuiScope.SetRoot(Player.MakeScope).End)]"
        datacontext = "[GetEconomyView]"
        datamodel = "[EconomyView.GetMaintenanceSettings]"
        item = {
            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 92 }
                visible = "[MaintenanceSetting.IsBureaucracy]"
                using = bg_paper_card
                using = bg_cabinet_card_frame
                vbox = {
                    size = { 100% 100% }
                    layoutpolicy_horizontal = expanding
                    margin = { 12 8 }
                    spacing = 8
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 8
                        icon = { size = { 24 24 } texture = "[MaintenanceSetting.GetIcon]" }
                        text_single = { text = "[MaintenanceSetting.GetName]" fontsize = 17 }
                        expand = {}
                        text_single = { raw_text = "[MaintenanceSetting.GetExpenseWithCurrency]" }
                        tooltipwidget = { using = ExpenseSettingTooltip }
                    }
                    economy_slider = {
                        size = { 350 10 }
                        min = 0
                        max = 1
                        value = "[MaintenanceSetting.GetDefault]"
                        mincap = "[MaintenanceSetting.GetMin]"
                        maxcap = "[MaintenanceSetting.GetMax]"
                        onvaluechanged = "[MaintenanceSetting.OnChanged]"
                        onchangefinish = "[MaintenanceSetting.Post]"
                        enabled = "[And(MaintenanceSetting.IsEnabled,Not(IsPlayerAIEnabled('finances')))]"
                        blockoverride "economy_slider_inc_button_config" { enabled = "[MaintenanceSetting.IsIncEnabled]" }
                        blockoverride "economy_slider_dec_button_config" { enabled = "[MaintenanceSetting.IsDecEnabled]" }
                    }
                }
            }
        }
    }

    type oe_pillars_transfer_sliders = vbox {
        layoutpolicy_horizontal = expanding
        spacing = 8
        datamodel = "[InternationalOrganizationsView.GetIOMaintenanceSettings]"
        item = {
            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 82 }
                using = bg_paper_card
                using = bg_cabinet_card_frame
                visible = "[And(MaintenanceSetting.ShowSlider,Not(Or(EqualTo_string(MaintenanceSetting.GetNameWithNoTooltip,Localize('oe_pillars_authority_budget')),EqualTo_string(MaintenanceSetting.GetNameWithNoTooltip,Localize('oe_pillars_egypt_food_budget')))))]"
                vbox = {
                    size = { 100% 100% }
                    layoutpolicy_horizontal = expanding
                    margin = { 12 8 }
                    spacing = 10
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { text = "[MaintenanceSetting.GetName]" fontsize = 17 }
                        expand = {}
                        text_single = { raw_text = "[MaintenanceSetting.GetExpenseWithCurrency]" }
                        tooltipwidget = { using = ExpenseSettingTooltip }
                    }
                    economy_slider = {
                        size = { 350 10 }
                        min = 0
                        max = 1
                        value = "[MaintenanceSetting.GetDefault]"
                        mincap = "[MaintenanceSetting.GetMin]"
                        maxcap = "[MaintenanceSetting.GetMax]"
                        onvaluechanged = "[MaintenanceSetting.OnChanged]"
                        onchangefinish = "[MaintenanceSetting.Post]"
                        enabled = "[And(MaintenanceSetting.IsEnabled,Not(IsPlayerAIEnabled('finances')))]"
                        blockoverride "economy_slider_inc_button_config" { enabled = "[MaintenanceSetting.IsIncEnabled]" }
                        blockoverride "economy_slider_dec_button_config" { enabled = "[MaintenanceSetting.IsDecEnabled]" }
                    }
                }
            }
        }
    }
    type oe_pillars_payment_ledger = vbox {
        layoutpolicy_horizontal = expanding
        spacing = 8
        datacontext = "[InternationalOrganizationsView.GetInternationalOrganization]"
        datamodel = "[InternationalOrganization.GetPayments]"
        item = {
            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 146 }
                using = bg_paper_card
                using = bg_cabinet_card_frame
                visible = "[Or(EqualTo_string(Payment.GetNameWithContext(InternationalOrganization.Self),Localize('oe_pillars_nobles_contribution')),EqualTo_string(Payment.GetNameWithContext(InternationalOrganization.Self),Localize('oe_pillars_clergy_contribution')))]"
                vbox = {
                    size = { 100% 100% }
                    layoutpolicy_horizontal = expanding
                    margin = { 12 8 }
                    spacing = 5
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { text = "[Payment.GetNameWithContext(InternationalOrganization.Self)]" fontsize = 16 }
                        expand = {}
                        text_single = { text = "[Payment.GetPayeePrice(InternationalOrganization.Self)]" }
                    }
                    
                    text_single = { visible = "[EqualTo_string(Payment.GetNameWithContext(InternationalOrganization.Self),Localize('oe_pillars_nobles_contribution'))]" text = "oe_pillars_nobles_contribution_desc" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
text_single = { visible = "[EqualTo_string(Payment.GetNameWithContext(InternationalOrganization.Self),Localize('oe_pillars_clergy_contribution'))]" text = "oe_pillars_clergy_contribution_desc" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
# PAUSED house income: text_single = { visible = "[EqualTo_string(Payment.GetNameWithContext(InternationalOrganization.Self),Localize('oe_pillars_houses_contribution'))]" text = "oe_pillars_houses_contribution_desc" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                }
            }
        }
    }
}


# Shared native Country cards for ordinary and special military commands.
template oe_pillars_member_shields {
    fixedgridbox = {
                addcolumn = 158
                addrow = 140
                flipdirection = yes
                datamodel_wrap = 3
                datamodel_reuse_widgets = yes
                datamodel = "[MemberTypeItem.GetCountries]"
                item = {
                    widget = { using = oe_pillars_country_card }
                }
            }
}

# Shared country card: native groups and special-theme groups have identical contents.
template oe_pillars_country_card {
size = { 152 132 }
                        using = bg_paper_card
                        using = bg_cabinet_card_frame
                        vbox = {
                            size = { 100% 100% }
                            margin = { 6 6 }
                            spacing = 3
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                expand = {}
                                country_flag_small_plus = { size = { 32 24 } }
                                expand = {}
                            }
                            text_single = {
                                layoutpolicy_horizontal = expanding
                                multiline = yes
                                autoresize = yes
                                maximumsize = { 140 42 }
                                fontsize = 17
                                text = "[Country.GetNameWithNoTooltip]"
                                tooltip = "[Country.GetName]"
                            }
                            text_single = {
                                layoutpolicy_horizontal = expanding
                                maximumsize = { 140 23 }
                                fontsize = 16
                                text = "[Country.GetGovernment.GetRuler.GetShortNameWithNoTooltip]"
                                tooltip = "[Country.GetGovernment.GetRuler.GetName]"
                            }
                            text_single = {
                                layoutpolicy_horizontal = expanding
                                maximumsize = { 140 23 }
                                fontsize = 16
                                text = "[Country.GetCapital.GetName]"
                            }
                        }
}
