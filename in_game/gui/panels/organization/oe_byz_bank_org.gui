organization_geodiplomatic_theme = {
    
    blockoverride "organization_laws_tab_text" { # Hide laws tab
        text = "OE_BANK_ORG_LAWS"
    }
    	blockoverride "organization_candidates_tab_visible" {
		visible = yes
	}
    blockoverride "card_header_button_header_content" { # Remove leave/join/invite IO icon + add member icon
        margin_left = 18
        icon = {
            size = { 30 30 }
            block "card_header_button_icon_texture" {
                texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
            }
            texture_density = 2
            glow = {
                name = "drop_shadow"
                glow_radius = 3
                color = {0.0 0.0 0.0 1.0}
                alpha = 0.3
            }
        }
        block "card_header_button_text_single" {
            text_single = {
                margin_left = 7
                block "card_header_button_raw_text" {
                    raw_text = "IO or Situation"
                }
            }
        }
        expand = {}
    }

    blockoverride "organization_overview_tab_visible" {}
    blockoverride "organization_panel_overview_visible" {
        visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
    }
    blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}
	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

    blockoverride "scroll_overview_empty_visible" { visible = no }
    
    blockoverride "io_main_actions_icon" {
        texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
    }

    blockoverride "organization_main_actions_extra_visible" {
        visible = yes 
    }

    blockoverride "organization_overview_filtered_list_type" {
		datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
        blockoverride "scroll_list_is_empty" {
            block "scroll_overview_empty_visible" {
                visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
            }
        }
    }

    blockoverride "organization_overview_list_custom_top_extra" {
        #expand = {}
        vbox = {
            margin = { 10 5 }
            layoutpolicy_horizontal = expanding
            card_expandable = { # Prince of Vladimir info
                blockoverride "header_content" {
                    margin = { 10 0 }
                    icon = {
                        size = { 30 30 }
                        block "common_header_icon_texture" {
                            texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
                        }
                        texture_density = 2
                    }                                            
                    text_single = {
                        block "header_text" {
                            margin = { 10 0 }
                            text = "oe_byz_bank_org_leader_tt_tit"
                        }
                    }
                    expand = {}
                }
                blockoverride "bottom_content" {
                    margin_top = 15
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        text_single = {
                            margin = { 20 10 }
                            text = "oe_byz_bank_org_leader_tt_desc"
                            multiline = yes
                            autoresize = yes
                            layoutpolicy_horizontal = expanding
                        }
                    }
                }
                blockoverride "header_button_onclick" {
                    onclick = "[GetVariableSystem.Toggle( 'oe_byz_bank_summary_collapsed' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[Not(GetVariableSystem.Exists( 'oe_byz_bank_summary_collapsed' ))]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[GetVariableSystem.Exists( 'oe_byz_bank_summary_collapsed' )]"
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[Not(GetVariableSystem.Exists( 'oe_byz_bank_summary_collapsed' ))]"
                }
                margin_bottom = 10
            }
        }
    }



    blockoverride "organization_main_actions_extra" {#加入和退出行动
        #Join io
        button_regular_diamond = {
            size = { 470 30 }
            text = "ASK_FOR_IO_MEMBERSHIP"
            tooltipwidget = {
                using = io_join_button_tooltip
            }
            visible = "[And(Not(Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)),PdxGuiWidget.IsUberButtonVisible)]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
            scripted_action_tooltip = {
                click_type = left
                click_mode = single
                actor = "[InternationalOrganizationsView.GetPlayer]"
                action_name = "ask_to_join_international_organization"
                action_direction = "request"
                parameter = {
                                    parameter_name = "international_organization"
                                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                }
                parameter = {
                                parameter_name = "recipient"
                                parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
                            }
            }
        }
        #leave io
        button_regular_diamond = {
            size = { 470 30 }
            text = "LEAVE_IO_MEMBERSHIP"
            tooltipwidget = {
                using = io_leave_button_tooltip
            }
            visible = "[And(Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization),PdxGuiWidget.IsUberButtonVisible)]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
            scripted_action_tooltip = {
                click_type = left
                click_mode = single
                actor = "[InternationalOrganizationsView.GetPlayer]"
                action_name = "leave_international_organization"
                action_direction = "offer"
                parameter = {
                                    parameter_name = "recipient"
                                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                }
            }
        }
		#vote
				button_regular_diamond = {
				    size = {470 30}
				    text = "VOTE_IO_LEADER"
				    tooltipwidget = {
				    	using = io_vote_button_tooltip
				    }
				    visible = "[PdxGuiWidget.IsUberButtonVisible]"
				    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
				    scripted_action_tooltip = {
				        click_type = left
				        click_mode = single
				        actor = "[InternationalOrganizationsView.GetPlayer]"
				        action_name = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeadershipElectionResolution.GetKey]"
				        parameter = {
				        				parameter_name = "recipient"
				        				parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
				        			}
				    }
				}
    }


}
 





	
