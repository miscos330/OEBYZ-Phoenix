# Project Phoenix v40.0 WP33: Phoenix Master Console (5-Tab Command Dock, Brebion & World Compass). Generated by gen_v310_wp33_phoenix_ui2_directives.py; edit the generator.
# Auto-mounted via in_game/gui/scripted_widgets/oe_wp33_command_dock.txt (ZERO vanilla overrides, ZERO Glorp UI overlap).
# Strict EU5 1.4.9 hygiene: GetPlayer.IsValid guarded, 0 parentanchor inside hbox/vbox, 0 flowcontainer size=, fontsize >= 13.
# Lazy-instantiated panel body via DataModelRepeatedItem(Select_int32(..., 1, 0)): 0.00 ms steady-state cost while collapsed.

window = {
    name = "oe_wp33_dock_toggle_window"
    layer = topbar
    parentanchor = bottom|left
    widgetanchor = bottom|left
    position = { 18 -158 }
    size = { 176 34 }
    movable = yes
    resizable = no
    alwaystransparent = no
    allow_outside = yes
    datacontext = "[GetPlayer]"
    visible = "[And(GetPlayer.IsValid, And(And(Not(IsLobbyOpen), Not(IsTimeLineMode)), And(Not(IsLateralViewFullScreen), Not(LeftView.IsShown))))]"

    button_regular = {
        name = "oe_wp33_dock_toggle_btn"
        size = { 176 34 }
        onclick = "[GetVariableSystem.Toggle('oe_wp33_dock_open')]"
        onclick = "[GetScriptedGui('oe_wp33_refresh_brebion').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        tooltip = "OE_WP33_PILL_TT"
        using = bg_dark_paper_card
        using = bg_header_golden_frame

        hbox = {
            size = { 100% 100% }
            margin = { 8 0 }
            spacing = 6

            icon = {
                size = { 20 20 }
                texture = "gfx/interface/icons/country_ranks/rank_empire.dds"
                alwaystransparent = yes
            }

            text_single = {
                layoutpolicy_horizontal = expanding
                align = left|nobaseline
                elide = right
                fontsize = 13
                default_format = "#yellow_titles"
                text = "OE_WP33_PILL_TITLE"
                alwaystransparent = yes
            }

            icon = {
                visible = "[Not(GetVariableSystem.Exists('oe_wp33_dock_open'))]"
                size = { 14 14 }
                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                using = button_regular_icon_color
                alwaystransparent = yes
            }

            icon = {
                visible = "[GetVariableSystem.Exists('oe_wp33_dock_open')]"
                size = { 14 14 }
                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                using = button_regular_icon_color
                alwaystransparent = yes
            }
        }
    }
}

window = {
    name = "oe_wp33_command_dock_window"
