types oe_roman_assimilation_widgets {
    type oe_rw_assimilation_panel = card_common {
        blockoverride "header_decor_templates" { using = oe_header_imperial_purple }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
        blockoverride "common_header_text_full" { text_single = { text = "OE_RW_ASSIM_TITLE" fontsize = 20 } }
        blockoverride "common_bottom_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                margin = { 10 10 } spacing = 12
                widget = {
                    name = "oe_rw_assimilation_illustration"
                    layoutpolicy_horizontal = expanding size = { -1 250 }
                    background = {
                        texture = "gfx/interface/illustrations/international_organization_types/oe_rw_assimilation.dds"
                        spriteType = stretched
                    }
                }
                text_single = { text = "OE_RW_ASSIM_FLAVOR" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                # fx27 UI-2 (Decision 309): O(1) client-side 4-region filter bar (GetVariableSystem).
                vbox = {
                    name = "oe_ui2_assim_filter_bar"
                    layoutpolicy_horizontal = expanding
                    spacing = 5
                    widget = {
                        layoutpolicy_horizontal = expanding
                        size = { -1 28 }
                        using = oe_era_banner_purple
                        hbox = {
                            size = { 100% 100% }
                            margin = { 10 0 }
                            text_single = {
                                layoutpolicy_horizontal = expanding
                                align = left|nobaseline
                                fontsize = 14
                                default_format = "#yellow_titles"
                                text = "OE_UI2_ASSIM_FILTER_BANNER"
                            }
                        }
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 30 }
                            blockoverride "tab_text" { text = "OE_UI2_ASSIM_TAB_ALL" fontsize = 13 }
                            tooltip = "OE_UI2_ASSIM_TAB_ALL_TT"
                            onclick = "[GetVariableSystem.Set('oe_assim_reg','all')]"
                            down = "[Or(Not(GetVariableSystem.Exists('oe_assim_reg')),GetVariableSystem.HasValue('oe_assim_reg','all'))]"
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 30 }
                            blockoverride "tab_text" { text = "OE_UI2_ASSIM_TAB_BALKAN" fontsize = 13 }
                            tooltip = "OE_UI2_ASSIM_TAB_BALKAN_TT"
                            onclick = "[GetVariableSystem.Set('oe_assim_reg','balkan')]"
                            down = "[GetVariableSystem.HasValue('oe_assim_reg','balkan')]"
                        }
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 30 }
                            blockoverride "tab_text" { text = "OE_UI2_ASSIM_TAB_ANATOLIA" fontsize = 13 }
                            tooltip = "OE_UI2_ASSIM_TAB_ANATOLIA_TT"
                            onclick = "[GetVariableSystem.Set('oe_assim_reg','anatolia')]"
                            down = "[GetVariableSystem.HasValue('oe_assim_reg','anatolia')]"
                        }
                        button_secondary_tab_alt = {
                            layoutpolicy_horizontal = expanding
                            size = { -1 30 }
                            blockoverride "tab_text" { text = "OE_UI2_ASSIM_TAB_MEDWEST" fontsize = 13 }
                            tooltip = "OE_UI2_ASSIM_TAB_MEDWEST_TT"
                            onclick = "[GetVariableSystem.Set('oe_assim_reg','medwest')]"
                            down = "[GetVariableSystem.HasValue('oe_assim_reg','medwest')]"
                        }
                    }
                }
                hbox = {
                    name = "oe_rw_turkish_assimilation_row"
                    visible = "[Or(Or(Not(GetVariableSystem.Exists('oe_assim_reg')),GetVariableSystem.HasValue('oe_assim_reg','all')),GetVariableSystem.HasValue('oe_assim_reg','anatolia'))]"
                    layoutpolicy_horizontal = expanding spacing = 14
                    margin = { 10 8 }
                    using = bg_paper_card
                    using = bg_cabinet_card_frame
                    vbox = {
                        layoutpolicy_horizontal = expanding spacing = 6
                        text_single = { text = "OE_RW_ASSIM_TURKISH_ROW" fontsize = 20 layoutpolicy_horizontal = expanding }
                        text_single = { text = "OE_RW_ASSIM_TURKISH_WAITING" fontsize = 16 layoutpolicy_horizontal = expanding visible = "[Not(GetScriptedGui('oe_rw_turkish_romanization_started').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End))]" }
                        text_single = { text = "OE_RW_ASSIM_TURKISH_STARTED" fontsize = 16 layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('oe_rw_turkish_romanization_started').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]" }
                    }
                    widget = {
                        name = "oe_rw_turkish_button_host"
                        size = { 72 72 }
                        tooltipwidget = { using = oe_rw_assim_turkish_tooltip }
                        mission_task_card_button = {
                            name = "oe_rw_start_turkish_romanization_button"
                            size = { 72 72 } text = ""
                            enabled = "[GetScriptedGui('oe_rw_start_turkish_romanization').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            tooltipwidget = { using = oe_rw_assim_turkish_tooltip }
                            onclick = "[GetScriptedGui('oe_rw_start_turkish_romanization').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            icon = { size = { 52 52 } parentanchor = center texture = "gfx/interface/icons/movement/oe_turkish_identity_movement.dds" alwaystransparent = yes }
                        }
                        # Enabled hover surface over a disabled button. It has no click handler.
                        widget = {
                            name = "oe_rw_turkish_disabled_hover"
                            ignore_layout = yes
                            parentanchor = left|top widgetanchor = left|top size = { 72 72 }
                            alwaystransparent = no
                            visible = "[Not(GetScriptedGui('oe_rw_start_turkish_romanization').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End))]"
                            tooltipwidget = { using = oe_rw_assim_turkish_tooltip }
                        }
                    }
                }
                hbox = {
