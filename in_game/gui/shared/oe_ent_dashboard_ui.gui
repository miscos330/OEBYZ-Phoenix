                                        visible = "[GetPlayer.MakeScope.GetVariable('oe_ent_cache_prf_mil').IsSet]"
                                        text_single = {
                                            layoutpolicy_horizontal = expanding
                                            align = hcenter|nobaseline
                                            fontsize = 15
                                            default_format = "#bold #color_gold"
                                            raw_text = "[GetPlayer.MakeScope.GetVariable('oe_ent_cache_prf_mil').GetValue|0]"
                                        }
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[Not(GetPlayer.MakeScope.GetVariable('oe_ent_cache_prf_mil').IsSet)]"
                                        align = hcenter|nobaseline
                                        fontsize = 15
                                        default_format = "#bold #color_gold"
                                        raw_text = "0"
                                    }
                                }
                            }
                            oe_kpi_tile = {
                                tooltip = "OE_ENT_UI_MIT_LOY_TT"
                                blockoverride "kpi_label" {
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        align = hcenter|nobaseline
                                        elide = right
                                        fontsize = 11
                                        default_format = "#weak"
                                        text = "OE_ENT_UI_MIT_LOY"
                                    }
                                }
                                blockoverride "kpi_value" {
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[GetPlayer.MakeScope.GetVariable('oe_ent_cache_low_loy').IsSet]"
                                        text_single = {
                                            layoutpolicy_horizontal = expanding
                                            align = hcenter|nobaseline
                                            fontsize = 15
                                            default_format = "#bold #R"
                                            raw_text = "[GetPlayer.MakeScope.GetVariable('oe_ent_cache_low_loy').GetValue|0]"
                                        }
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[Not(GetPlayer.MakeScope.GetVariable('oe_ent_cache_low_loy').IsSet)]"
                                        align = hcenter|nobaseline
                                        fontsize = 15
                                        default_format = "#bold #R"
                                        raw_text = "0"
                                    }
                                }
                            }
                        }
                        hbox = {
                            visible = "[GetPlayer.MakeScope.GetVariable('oe_ent_ar_merged').IsSet]"
                            layoutpolicy_horizontal = expanding
                            margin = { 8 5 }
                            spacing = 6
                            using = bg_dark_paper_card
                            using = bg_header_golden_frame
                            tooltip = "OE_ENT_UI_AR_MERGED_TT"
                            icon = {
                                size = { 18 18 }
                                texture = "gfx/interface/icons/diplomatic_status/tick_accept.dds"
                                alwaystransparent = yes
                            }
                            text_single = {
                                layoutpolicy_horizontal = expanding
                                align = left|nobaseline
                                elide = right
                                fontsize = 12
                                default_format = "#G"
                                text = "OE_ENT_UI_AR_MERGED"
                            }
                        }
                    }

                    text_single = {
                        layoutpolicy_horizontal = expanding
                        multiline = yes
                        autoresize = yes
                        maximumsize = { 468 -1 }
                        fontsize = 12
                        default_format = "#weak"
                        text = "OE_ENT_UI_MIT_NOTE"
                    }
                }
            }
        }

        # 4. Active Countermeasure Bar (4 ScriptedGui Actions + Decisions Shortcut)
        card_common = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_decor_templates" { using = oe_header_imperial_purple }
            blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/alerts_icons/decisions.dds" }
            blockoverride "common_header_text_full" { text_single = { text = "OE_ENT_UI_ACT_TITLE" fontsize = 16 } }
            blockoverride "common_bottom_content" {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 8 }
                    spacing = 6
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                            button_regular = {
                                name = "oe_ent_btn_currency"
                                layoutpolicy_horizontal = expanding
                                size = { -1 36 }
                                tooltip = "OE_ENT_UI_BTN_CURRENCY_TT"
                                enabled = "[GetScriptedGui('oe_ent_gui_currency_reform').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onclick = "[GetScriptedGui('oe_ent_gui_currency_reform').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                hbox = {
                                    size = { 100% 100% }
                                    margin = { 8 0 }
                                    spacing = 6
                                    icon = {
                                        size = { 20 20 }
                                        texture = "gfx/interface/icons/alerts_icons/alert_high_inflation_rising.dds"
                                        alwaystransparent = yes
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        align = left|nobaseline
                                        fontsize = 13
                                        elide = right
                                        text = "OE_ENT_UI_BTN_CURRENCY"
                                        alwaystransparent = yes
                                    }
                                }
                            }
                            button_regular = {
                                name = "oe_ent_btn_inspect"
                                layoutpolicy_horizontal = expanding
                                size = { -1 36 }
                                tooltip = "OE_ENT_UI_BTN_INSPECT_TT"
                                enabled = "[GetScriptedGui('oe_ent_gui_admin_inspect').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onclick = "[GetScriptedGui('oe_ent_gui_admin_inspect').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                hbox = {
                                    size = { 100% 100% }
                                    margin = { 8 0 }
                                    spacing = 6
                                    icon = {
                                        size = { 20 20 }
                                        texture = "gfx/interface/icons/alerts_icons/setup_a_law.dds"
                                        alwaystransparent = yes
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        align = left|nobaseline
                                        fontsize = 13
                                        elide = right
                                        text = "OE_ENT_UI_BTN_INSPECT"
                                        alwaystransparent = yes
                                    }
                                }
                            }
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                            button_regular = {
                                name = "oe_ent_btn_tolerance"
                                layoutpolicy_horizontal = expanding
                                size = { -1 36 }
                                tooltip = "OE_ENT_UI_BTN_TOLERANCE_TT"
                                enabled = "[GetScriptedGui('oe_ent_gui_tolerance_charter').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onclick = "[GetScriptedGui('oe_ent_gui_tolerance_charter').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                hbox = {
                                    size = { 100% 100% }
                                    margin = { 8 0 }
                                    spacing = 6
                                    icon = {
                                        size = { 20 20 }
                                        texture = "gfx/interface/icons/alerts_icons/diplomacy.dds"
                                        alwaystransparent = yes
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        align = left|nobaseline
                                        fontsize = 13
                                        elide = right
                                        text = "OE_ENT_UI_BTN_TOLERANCE"
                                        alwaystransparent = yes
                                    }
                                }
                            }
                            button_regular = {
                                name = "oe_ent_btn_amnesty"
                                layoutpolicy_horizontal = expanding
                                size = { -1 36 }
                                tooltip = "OE_ENT_UI_BTN_AMNESTY_TT"
                                enabled = "[GetScriptedGui('oe_ent_gui_amnesty_peace').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onclick = "[GetScriptedGui('oe_ent_gui_amnesty_peace').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                hbox = {
                                    size = { 100% 100% }
                                    margin = { 8 0 }
                                    spacing = 6
                                    icon = {
                                        size = { 20 20 }
                                        texture = "gfx/interface/icons/alerts_icons/war_exhaustion.dds"
                                        alwaystransparent = yes
                                    }
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        align = left|nobaseline
                                        fontsize = 13
                                        elide = right
                                        text = "OE_ENT_UI_BTN_AMNESTY"
                                        alwaystransparent = yes
                                    }
                                }
                            }
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 8
                        text_single = {
                            layoutpolicy_horizontal = expanding
                            multiline = yes
                            autoresize = yes
                            maximumsize = { 336 -1 }
                            fontsize = 11
                            default_format = "#weak"
                            text = "OE_ENT_UI_ACT_HINT"
                        }
                        button_regular = {
                            name = "oe_ent_btn_open_decisions"
                            size = { 128 30 }
                            onclick = "[OpenLateralViewWithParams('decisions', 'subtab = decisions')]"
                            tooltip = "OE_ENT_UI_BTN_DECISIONS_TT"
                            hbox = {
                                size = { 100% 100% }
                                margin = { 6 0 }
                                spacing = 4
                                icon = {
                                    size = { 16 16 }
                                    texture = "gfx/interface/icons/alerts_icons/decisions.dds"
                                    alwaystransparent = yes
                                }
                                text_single = {
                                    layoutpolicy_horizontal = expanding
                                    align = left|nobaseline
                                    fontsize = 12
                                    elide = right
                                    text = "OE_ENT_UI_BTN_DECISIONS"
                                    alwaystransparent = yes
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # Draggable/closable floating modal window for Great Yuan, Russia, and all giant empires
    type oe_ent_modal_window = window {
        name = "oe_ent_modal_window"
        parentanchor = center
        widgetanchor = center
        size = { 560 720 }
        movable = yes
        resizable = no
        alwaystransparent = no
        allow_outside = yes
        datacontext = "[GetPlayer]"
        visible = "[And(And(Not(IsLobbyOpen), Not(IsTimeLineMode)), And(IsPlayerValid, GetVariableSystem.Exists('oe_ent_modal_open')))]"
        using = bg_dark_paper_card
        using = bg_header_golden_frame

        vbox = {
            size = { 100% 100% }
            spacing = 0

            # Modal title bar with close button
            hbox = {
                layoutpolicy_horizontal = expanding
                size = { -1 38 }
                margin = { 12 4 }
                spacing = 8
                using = oe_header_imperial_purple
                icon = {
                    size = { 22 22 }
                    texture = "gfx/interface/icons/alerts_icons/alert_doom.dds"
                    alwaystransparent = yes
                }
                text_single = {
                    layoutpolicy_horizontal = expanding
                    align = left|nobaseline
                    fontsize = 16
                    default_format = "#bold #color_gold"
                    text = "OE_ENT_UI_MODAL_TITLE"
                }
                button_regular = {
                    name = "oe_ent_modal_close_btn"
                    size = { 28 28 }
                    onclick = "[GetVariableSystem.Toggle('oe_ent_modal_open')]"
                    tooltip = "OE_ENT_UI_MODAL_CLOSE_TT"
                    icon = {
                        parentanchor = center
                        size = { 16 16 }
                        texture = "gfx/interface/buttons/flats/close_button.dds"
                        using = button_regular_icon_color
                        alwaystransparent = yes
                    }
                }
            }

            # Scrollable shared dashboard body
            scrollarea = {
                using = layoutpolicy_expanding
                scrollbarpolicy_horizontal = always_off
                scrollbar_vertical = { using = Scrollbar_Vertical }
                scrollwidget = {
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        margin = { 10 8 }
                        spacing = 6
                        oe_ent_dashboard_body = {}
                    }
                }
            }
        }
    }
}
