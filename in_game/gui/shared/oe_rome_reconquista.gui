# NEW 2026-11-17 Roman Reconquest card. Generated by gen_rome_reconquista.py; edit the generator, not this file.
# Art reuses existing textures: the author's reconquest illustration, the ten Roman world region maps (dimmed until
# restored) and vanilla's purple progress bar.
types oe_rome_reconquista_widgets {
    type oe_rr_card = card_common {
        blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/situations/rome_reconquista.dds" }
