                        direction = horizontal
                    }
                }
                text_single = { text = "OE_RR_CARD_COUNT" fontsize = 16 layoutpolicy_horizontal = expanding }
                hbox = {
                    spacing = 6
                    expand = {}
                    vbox = {
                        spacing = 2
