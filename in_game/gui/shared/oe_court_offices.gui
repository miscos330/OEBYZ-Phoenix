# One 512 x 640 panel, with a 2 / 3 / 2 court hierarchy.
# Portrait, native office ribbon, benefit and number; character names remain in portrait tooltips.
types oe_court_widgets {
    type oe_court_unified_panel = widget {
        name = "oe_court_unified_panel"
        size = { 512 640 }
        layoutpolicy_horizontal = fixed
        layoutpolicy_vertical = fixed
        background = {
            texture = "gfx/interface/component_decoration/ios/oe_pillars/court_offices_unified.dds"
            spriteType = stretched
        }
        
# PAUSED 2026-09-26: Panel headings are opt-in; keep the page tab label.
# text_single = {
#             position = { 24 13 } size = { 464 24 }
#             text = "OE_COURT_TITLE"
#             fontsize = 19 default_format = "#bold #yellow_titles"
#             align = center autoresize = no
#             tooltip = "OE_COURT_DESC"
#         }

        widget = {
            name = "oe_court_chancellor_seat"
            position = { 104 64 } size = { 136 157 }
            widget = {
                name = "oe_court_chancellor_portrait_host"
                position = { 26 0 } size = { 84 96 }
                button_regular_diamond = {
                    name = "oe_court_chancellor_empty_portrait"
                    size = { 100% 100% }
                    text = "OE_COURT_VACANT"
                    fontsize = 14
                    datacontext = "[GetGenericAction('oe_court_chancellor_appoint')]"
                    tooltipwidget = { using = io_generic_action_button_tooltip }
                    visible = "[And(Not(GetScriptedGui('oe_court_chancellor_filled').IsShown(GuiScope.SetRoot(GetCountry('BYZ').MakeScope).End)),PdxGuiWidget.IsUberButtonVisible)]"
                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                    scripted_action_tooltip = {
                        click_type = left
                        click_mode = single
                        action_name = "oe_court_chancellor_appoint"
                        actor = "[InternationalOrganizationsView.GetPlayer]"
                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                    }
                }
                widget = {
                    size = { 100% 100% } visible = "[GetScriptedGui('oe_court_chancellor_filled').IsShown(GuiScope.SetRoot(GetCountry('BYZ').MakeScope).End)]"
                    datacontext = "[GetCountry('BYZ').MakeScope.GetVariable('oe_court_chancellor').GetCharacter]"
                    using = character_portrait_bg
                    portrait_standard_head_framed_button = {
                        size = { 72 86 } position = { 6 7 }
                    }
                }
                widget = {
                    size = { 20 20 } position = { 68 -3 }
                    visible = "[And(GetScriptedGui('oe_court_chancellor_filled').IsShown(GuiScope.SetRoot(GetCountry('BYZ').MakeScope).End),GetScriptedGui('oe_court_chancellor_dismiss').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End))]"
                    tooltip = "OE_COURT_DISMISS_TT"
                    button_regular_diamond = {
                        size = { 100% 100% } text = "×" fontsize = 17
                        tooltip = "OE_COURT_DISMISS_TT"
                        enabled = "[GetScriptedGui('oe_court_chancellor_dismiss').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        onclick = "[GetScriptedGui('oe_court_chancellor_dismiss').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                    }
                }
            }
            widget = {
                name = "oe_court_chancellor_office_ribbon"
                position = { 0 90 } size = { 136 26 }
                using = bg_name_banner
                blockoverride "bg_name_banner_margin" { margin = { 0 0 } }
                tooltip = "oe_court_chancellor_desc"
                text_single = {
                    position = { 7 1 } size = { 122 23 }
                    text = "#bold #Y [Localize('oe_court_chancellor')]#!#!"
                    using = Font_Type_Headers
                    fontsize = 15 fontsize_min = 12
                    align = center autoresize = no elide = right
                    alwaystransparent = yes
                }
            }
            
            text_single = {
                name = "oe_court_chancellor_benefit_label"
                position = { 0 119 } size = { 136 18 }
                text = "oe_court_chancellor_benefit" default_format = "#high"
                fontsize = 14 fontsize_min = 11 align = center autoresize = no elide = right
                tooltip = "oe_court_chancellor_desc"
            }
            text_single = {
                name = "oe_court_chancellor_benefit_value"
                position = { 0 138 } size = { 136 19 }
                text = "#bold #G +[GuiScope.SetRoot(GetCountry('BYZ').MakeScope).ScriptValue('oe_court_chancellor_display')|2]#!#!"
                fontsize = 16 align = center autoresize = no
                tooltip = "oe_court_chancellor_desc"
            }
        }
        widget = {
            name = "oe_court_judge_seat"
            position = { 272 64 } size = { 136 157 }
            widget = {
                name = "oe_court_judge_portrait_host"
