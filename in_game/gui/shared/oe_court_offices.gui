                tooltip = "oe_court_domestikos_desc"
                text_single = {
                    position = { 7 1 } size = { 122 23 }
                    text = "#bold #Y [Localize('oe_court_domestikos')]#!#!"
                    using = Font_Type_Headers
                    fontsize = 15 fontsize_min = 12
                    align = center autoresize = no elide = right
                    alwaystransparent = yes
                }
            }
            
            text_single = {
                name = "oe_court_domestikos_benefit_label"
                position = { 0 119 } size = { 136 18 }
                text = "oe_court_domestikos_benefit" default_format = "#high"
                fontsize = 14 fontsize_min = 11 align = center autoresize = no elide = right
                tooltip = "oe_court_domestikos_desc"
            }
            text_single = {
                name = "oe_court_domestikos_benefit_value"
                position = { 0 138 } size = { 136 19 }
                text = "#bold #G +[GuiScope.SetRoot(GetCountry('BYZ').MakeScope).ScriptValue('oe_court_domestikos_display')|2]#!#!"
                fontsize = 16 align = center autoresize = no
                tooltip = "oe_court_domestikos_desc"
            }
        }
        widget = {
            name = "oe_court_auto_toggle_host"
            position = { 448 580 } size = { 52 52 }
            tooltip = "OE_COURT_AUTO_TT"
            button_automation_shortcut = {
                name = "oe_court_auto_toggle_button"
                size = { 48 48 }
                using = snd_UI_checkbutton_round
                enabled = "[GetScriptedGui('oe_court_auto_toggle').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('oe_court_auto_toggle').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                tooltip = "OE_COURT_AUTO_TT"
            }
            widget = {
                position = { 30 30 } size = { 22 22 }
                alwaystransparent = yes
                visible = "[GetScriptedGui('oe_court_auto_state').IsShown(GuiScope.SetRoot(GetCountry('BYZ').MakeScope).End)]"
                background = {
                    using = bg_button_light_round_texture
                    modify_texture = { using = color_dark_blue_texture }
                }
                text_single = {
                    size = { 22 22 } align = center fontsize = 20
                    raw_text = "#bold #G ✓#!#!" autoresize = no alwaystransparent = yes
                }
            }
        }
    }
}
