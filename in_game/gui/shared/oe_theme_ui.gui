# NEW 2026-11-17 theme-rework UI-1: the 军区 tab of the Imperial Pillars panel.
# Generated by gen_theme_ui.py; edit the generator and regenerate instead of editing by hand.

# Page body of the 军区 tab. Used from organization_panel in panels/organization/oe_byz_empire_pillars.gui.
# Vanilla card style, no panel title (team rule).
template oe_theme_ui_page {
    scrollarea = {
        size = { 100% 100% }
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
        scrollwidget = {
            vbox = {
                layoutpolicy_horizontal = expanding
                margin = { 16 12 }
                spacing = 8

            # Summary strip
            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 104 }
                using = bg_paper_card
                using = bg_cabinet_card_frame
                vbox = {
                size = { 100% 100% }
                margin = { 10 6 }
                spacing = 4
                hbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 2
                widget = {
                    size = { 72 46 }
                    vbox = {
                        size = { 100% 100% }
                        text_single = { text = "OE_THEME_UI_SUM_COUNT" fontsize = 14 default_format = "#weak" }
                        text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.ScriptValue('oe_theme_ui_count')|0]" fontsize = 20 }
                    }
                }
                widget = {
                    size = { 72 46 }
                    vbox = {
                        size = { 100% 100% }
                        text_single = { text = "OE_THEME_UI_SUM_AVG" fontsize = 14 default_format = "#weak" }
                        text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.ScriptValue('oe_theme_ui_avg_loyalty')|0]" fontsize = 20 }
                    }
                }
                widget = {
                    size = { 72 46 }
                    vbox = {
                        size = { 100% 100% }
                        text_single = { text = "OE_THEME_UI_SUM_RESTLESS" fontsize = 14 default_format = "#weak" }
                        text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.ScriptValue('oe_theme_ui_restless_count')|0]" fontsize = 20 }
                    }
                }
                widget = {
                    size = { 72 46 }
                    vbox = {
                        size = { 100% 100% }
                        text_single = { text = "OE_THEME_UI_SUM_WORKS" fontsize = 14 default_format = "#weak" }
                        text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.ScriptValue('oe_theme_ui_works_count')|0]" fontsize = 20 }
                    }
                }
                widget = {
                    size = { 72 46 }
                    vbox = {
                        size = { 100% 100% }
                        text_single = { text = "OE_THEME_UI_SUM_CREATABLE" fontsize = 14 default_format = "#weak" }
                        text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.ScriptValue('oe_theme_ui_creatable_count')|0]" fontsize = 20 }
                    }
                }
                    expand = {}
                    button_regular = {
                        size = { 120 40 } text = "OE_TB2_BTN_MANAGE_ALL" fontsize = 15
                        visible = "[GetScriptedGui('oe_tb2_ui_manage_all').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        enabled = "[GetScriptedGui('oe_tb2_ui_manage_all').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_TB2_BTN_MANAGE_ALL"
                            description = "OE_TB2_BTN_MANAGE_ALL_DESC"
                            enabled = "[GetScriptedGui('oe_tb2_ui_manage_all').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_tb2_ui_manage_all').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        }
                    }
                }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    expand = {}
                    widget = {
                        size = { 180 40 }
                        datacontext = "[GetGenericAction('oe_theme_found_all_action')]"
                        button_regular_diamond = {
                            size = { 100% 100% }
                            fontsize = 15
                            text = "OE_THEME_UI_BTN_FOUND_ALL"
                            tooltipwidget = { using = io_generic_action_button_tooltip }
                            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                            scripted_action_tooltip = {
                                click_type = left
                                click_mode = single
                                actor = "[InternationalOrganizationsView.GetPlayer]"
                                action_name = "[GenericAction.GetKey]"
                                parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                            }
                        }
                    }
                    button_regular = {
                        size = { 120 40 } text = "OE_TB2_BTN_ADVISE" fontsize = 15
                        visible = "[GetScriptedGui('oe_tb2_ui_advise').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        enabled = "[GetScriptedGui('oe_tb2_ui_advise').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_TB2_BTN_ADVISE"
                            description = "OE_TB2_BTN_ADVISE_DESC"
                            enabled = "[GetScriptedGui('oe_tb2_ui_advise').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_tb2_ui_advise').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        }
                    }
                    button_regular = {
                        size = { 120 40 } text = "OE_TB2_BTN_MARCHES" fontsize = 15
                        visible = "[GetScriptedGui('oe_tb2_ui_marches').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        enabled = "[GetScriptedGui('oe_tb2_ui_marches').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_TB2_BTN_MARCHES"
                            description = "OE_TB2_BTN_MARCHES_DESC"
                            enabled = "[GetScriptedGui('oe_tb2_ui_marches').IsValid(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_tb2_ui_marches').Execute(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
                        }
                    }
                    expand = {}
                }
                }
            }
            # v6.7 theme-ledger1 (design theme-econ 3.1): the crown's ledger of all themes this month (BYZ script values).
            text_single = {
                layoutpolicy_horizontal = expanding
                text = "OE_TE_SUM_LINE"
                tooltip = "OE_TE_SUM_TT"
                fontsize = 14
            }
            text_single = {
                layoutpolicy_horizontal = expanding
                visible = "[GetScriptedGui('oe_theme_ui_deterrence').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
                text = "OE_THEME_UI_SUM_DETER"
                fontsize = 14
            }
            # v6.7 A (gen_theme_quota.py): this year's replenishment of the themes, one sentence (custom loc OeTqSum on BYZ).
            text_single = {
                layoutpolicy_horizontal = expanding
                text = "OE_TQ_SUM_LINE"
                tooltip = "OE_TQ_SUM_TT"
                fontsize = 14
            }
            # v6.7 theme-managed1 (gen_theme_b2.py): the managed themes, one sentence (custom loc OeTb2Sum on BYZ).
            text_single = {
                layoutpolicy_horizontal = expanding
                text = "OE_TB2_SUM_LINE"
                tooltip = "OE_TB2_SUM_TT"
                fontsize = 14
            }
            # Theme revolt under way: rebels' hold on Constantinople (gen_theme_usurp.py).
            vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 3
                visible = "[GetScriptedGui('oe_theme_ui_usurp_progress').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
                text_single = { text = "OE_THEME_UI_USURP" fontsize = 14 layoutpolicy_horizontal = expanding }
                progressbar = {
                    layoutpolicy_horizontal = expanding
                    size = { -1 10 }
                    progresstexture = "gfx/interface/progressbars/progress_bar_red_alt.dds"
                    noprogresstexture = "gfx/interface/progressbars/progress_bar_grey_alt.dds"
                    texture_density = 2
                    spriteType = Corneredstretched
                    spriteborder = { 12 0 }
                    min = 0
                    max = 6
                    value = "[FixedPointToFloat(GetCountry('BYZ').MakeScope.GetVariable('oe_theme_usurp_months').GetValue)]"
                    direction = horizontal
                }
            }

            # Column headings (widths match the first line of each row)
            hbox = {
                layoutpolicy_horizontal = expanding
                margin = { 8 0 }
                spacing = 5
                text_single = { autoresize = no size = { 140 20 } text = "OE_THEME_UI_COL_THEME" fontsize = 14 default_format = "#weak" }
                text_single = { autoresize = no size = { 100 20 } text = "OE_THEME_UI_COL_STRATEGOS" fontsize = 14 default_format = "#weak" }
                text_single = { autoresize = no size = { 88 20 } text = "OE_THEME_UI_COL_LOYALTY" fontsize = 14 default_format = "#weak" }
                expand = {}
            }
            text_single = {
                layoutpolicy_horizontal = expanding
                visible = "[GetScriptedGui('oe_theme_ui_empty').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
                text = "OE_THEME_UI_EMPTY"
                fontsize = 15
                multiline = yes
                autoresize = yes
                maximumsize = { 380 -1 }
            }

            # One card per theme, three lines: who / how loyal, then offices / focus / works and the orders, then the ledger.
            # v6.7 theme-fix2 (r23 g7 甲 1, 甲 2): every width below is fixed, so a card's content never exceeds what a
            # march card with a pretender needs. Card 570 - 2 x 16 page margin, about 30 for the scrollbar -> about 508 wide
            # (385 px seen at a UI scale of 0.758), inner width about 492 (margin 8 each side).
            #   line 1: name 140 + strategos 100 + loyalty 88 [+ pretender 66] + expand + button 46, spacing 5:
            #           ordinary 374 + 4 x 5 = 394, with the pretender 440 + 5 x 5 = 465.
            #   line 2: tiers 190 + cell 64 (replenishment above, a march's border pressure below) + expand + 4 buttons
            #           (4 x 46 + 3 x 3 = 193), spacing 6: 447 + 3 x 6 = 465 on every card (the march adds nothing).
            #   height: 5 + 44 + 2 + 42 + 2 + 22 + 5 = 122 (was 118 with an 18 px ledger line under a 0 px clearance:
            #           the ledger and the fiscal line printed into each other). Texts of the lower lines are capped at
            #           20 px and centred without the baseline offset.
            vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 4
                datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetMembers]"
                item = {
                    widget = {
                        visible = "[GetScriptedGui('oe_theme_ui_row').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                        layoutpolicy_horizontal = expanding
                        size = { -1 122 }
                        using = bg_paper_card
                        using = bg_cabinet_card_frame
                        vbox = {
                            size = { 100% 100% }
                            margin = { 8 5 }
                            spacing = 2
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 5
                                widget = { size = { 140 44 }
                                    country_flag_small_plus = { size = { 28 21 } position = { 0 4 } }
                                    text_single = { position = { 34 0 } size = { 106 24 } autoresize = no elide = right fontsize = 16 text = "[Country.GetNameWithNoTooltip]" tooltip = "[Country.GetName]" }
                                    # Third round N1 (gen_round3_ui.py): status and course each carry their own tooltip.
                                    hbox = {
                                        position = { 34 24 } size = { 106 20 } spacing = 3
                                        text_single = { autoresize = yes maximumsize = { 50 20 } elide = right fontsize = 13 raw_text = "[Country.Custom('OeThemeTypeName')]" default_format = "#weak" tooltip = "OE_TU_CARD_STATUS_TT" }
                                        text_single = { autoresize = yes maximumsize = { 8 20 } fontsize = 13 raw_text = "·" default_format = "#weak" }
                                        text_single = { autoresize = yes maximumsize = { 44 20 } elide = right fontsize = 13 raw_text = "[Country.Custom('OeThemeFocusName')]" default_format = "#weak" tooltip = "OE_TU_CARD_COURSE_TT" }
                                        expand = {}
                                    }
                                }
                                widget = { size = { 100 44 }
                                    text_single = { position = { 0 0 } size = { 100 24 } autoresize = no elide = right fontsize = 15 text = "[Country.GetGovernment.GetRuler.GetShortNameWithNoTooltip]" tooltip = "[Country.GetGovernment.GetRuler.GetName]" }
                                    text_single = { position = { 0 24 } size = { 100 20 } autoresize = no elide = right fontsize = 13 text = "OE_THEME_UI_TENURE" default_format = "#weak" }
                                }
                                widget = { size = { 88 44 }
                                    tooltip = "OE_THEME_UI_LOYALTY_TT"
                                    text_single = { position = { 0 0 } size = { 88 24 } autoresize = no elide = right fontsize = 15 raw_text = "[Country.MakeScope.GetVariable('oe_theme_loyalty').GetValue|0]  [Country.Custom('OeThemeBand')]" }
                                    progressbar_framed = {
                                        position = { 0 28 }
                                        size = { 84 10 }
                                        using = progress_bar_green_red_alt
                                        min = 0
                                        max = 100
                                        value = "[FixedPointToFloat(Country.MakeScope.GetVariable('oe_theme_loyalty').GetValue)]"
                                    }
                                }
                                widget = { size = { 66 44 }
                                    visible = "[GetScriptedGui('oe_theme_ui_ambitious').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                                    tooltip = "OE_THEME_UI_AMBITION_TT"
                                    text_single = { position = { 0 12 } size = { 66 22 } autoresize = no elide = right fontsize = 13 text = "OE_THEME_UI_AMBITION" }
                                }
                                expand = {}
                                # v6.7 theme-managed1 (gen_theme_b2.py): 托管 / 已托管 (custom loc OeTb2MgBtn), at the right end of the
                                # first line (line 2 holds four buttons already).
                    button_regular = {
                        size = { 46 26 } text = "OE_TB2_BTN_MANAGE" fontsize = 13
                        enabled = "[GetScriptedGui('oe_tb2_ui_manage').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_TB2_BTN_MANAGE"
                            description = "OE_TB2_BTN_MANAGE_DESC"
                            enabled = "[GetScriptedGui('oe_tb2_ui_manage').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_tb2_ui_manage').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                        }
                    }
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 6
                                widget = { size = { 190 42 }
                                    text_single = { position = { 0 0 } size = { 190 22 } autoresize = no elide = right fontsize = 14 raw_text = "[Country.Custom('OeThemeTier1')]  [Country.Custom('OeThemeTier2')]  [Country.Custom('OeThemeTier3')]  [Country.Custom('OeThemeTier4')]  [Country.Custom('OeThemeTier5')]" tooltip = "OE_THEME_UI_TIERS_TT" }
                                    # Third round N1 (gen_round3_ui.py): the fiscal regime carries its own tooltip; the works keep theirs.
                                    hbox = {
                                        position = { 0 22 } size = { 190 20 } spacing = 3
                                        text_single = { autoresize = yes maximumsize = { 104 20 } elide = right align = left|nobaseline fontsize = 13 raw_text = "#weak [Localize('OE_THEME_UI_FISCAL_LABEL')]#! [Country.Custom('OeThemeFiscalName')]" tooltip = "OE_TU_CARD_FISCAL_TT" }
                                        text_single = { autoresize = yes maximumsize = { 8 20 } align = left|nobaseline fontsize = 13 raw_text = "·" default_format = "#weak" }
                                        text_single = { autoresize = yes maximumsize = { 72 20 } elide = right align = left|nobaseline fontsize = 13 raw_text = "[Country.Custom('OeThemeProject')]" tooltip = "OE_THEME_UI_PROJ_TT" }
                                        expand = {}
                                    }
                                }
                                # One fixed 64 px cell: the replenishment on the upper line, a march's border pressure on the lower.
                                widget = { size = { 64 42 }
                                    # v6.7 A (gen_theme_quota.py): replenishment cell, have/quota (land: thousands of regulars, navy: ships);
                                    # red = stopped (loyalty under 40), weak = at quota, plain = short. One text per state.
                                    widget = { size = { 64 20 } position = { 0 1 }
                                        visible = "[GetScriptedGui('oe_tq_ui_cell').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_none').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_NONE" tooltip = "OE_TQ_CELL_TT_LAND" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_land_red').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_LAND_RED" tooltip = "OE_TQ_CELL_TT_LAND" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_land_full').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_LAND_FULL" tooltip = "OE_TQ_CELL_TT_LAND" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_land_open').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_LAND_OPEN" tooltip = "OE_TQ_CELL_TT_LAND" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_sea_red').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_SEA_RED" tooltip = "OE_TQ_CELL_TT_SEA" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_sea_full').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_SEA_FULL" tooltip = "OE_TQ_CELL_TT_SEA" }
                                        text_single = { visible = "[GetScriptedGui('oe_tq_ui_sea_open').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TQ_CELL_SEA_OPEN" tooltip = "OE_TQ_CELL_TT_SEA" }
                                    }
                                    # Fourth round D3 (gen_round4_border.py): border pressure of a march; the tooltip lists its sources.
                                    widget = { size = { 64 20 } position = { 0 22 }
                                        visible = "[GetScriptedGui('oe_tbd_ui_march').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                                        tooltip = "OE_TBD_CARD_TT"
                                        text_single = { position = { 0 0 } size = { 64 20 } autoresize = no elide = right align = left|nobaseline fontsize = 13 raw_text = "[Country.Custom('OeTbdBand')] [Country.MakeScope.GetVariable('oe_tbd_pressure').GetValue|0]" }
                                    }
                                }
                                expand = {}
                                hbox = {
                                    spacing = 3
                    button_regular = {
                        size = { 46 26 } text = "OE_THEME_UI_BTN_FOCUS" fontsize = 13
                        enabled = "[GetScriptedGui('oe_theme_ui_open_focus').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_THEME_UI_BTN_FOCUS"
                            description = "OE_THEME_UI_BTN_FOCUS_DESC"
                            enabled = "[GetScriptedGui('oe_theme_ui_open_focus').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_theme_ui_open_focus').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                        }
                    }
                    button_regular = {
                        size = { 46 26 } text = "OE_THEME_UI_BTN_OFFICIALS" fontsize = 13
                        enabled = "[GetScriptedGui('oe_theme_ui_open_officials').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_THEME_UI_BTN_OFFICIALS"
                            description = "OE_THEME_UI_BTN_OFFICIALS_DESC"
                            enabled = "[GetScriptedGui('oe_theme_ui_open_officials').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_theme_ui_open_officials').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                        }
                    }
                    button_regular = {
                        size = { 46 26 } text = "OE_THEME_UI_BTN_WORKS" fontsize = 13
                        enabled = "[GetScriptedGui('oe_theme_ui_open_works').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_THEME_UI_BTN_WORKS"
                            description = "OE_THEME_UI_BTN_WORKS_DESC"
                            enabled = "[GetScriptedGui('oe_theme_ui_open_works').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_theme_ui_open_works').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                        }
                    }
                    button_regular = {
                        size = { 46 26 } text = "OE_THEME_UI_BTN_DISARM" fontsize = 13
                        enabled = "[GetScriptedGui('oe_theme_ui_disarm').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                        tooltipwidget = { using = action_tooltip_pop_out }
                        action_tooltip = {
                            title = "OE_THEME_UI_BTN_DISARM"
                            description = "OE_THEME_UI_BTN_DISARM_DESC"
                            enabled = "[GetScriptedGui('oe_theme_ui_disarm').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
                            on_action = "[GetScriptedGui('oe_theme_ui_disarm').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
                        }
                    }
                                }
                            }
                            # v6.7 theme-ledger1 (design theme-econ 3.1): the crown's ledger of this theme, display only.
                            text_single = { layoutpolicy_horizontal = expanding size = { -1 22 } autoresize = no elide = right align = left|nobaseline fontsize = 13 text = "OE_TE_CARD_LINE" tooltip = "OE_TE_CARD_TT" }
                        }
                    }
                }
            }
            expand = {}
            }
        }
    }
}
