# NEW 2026-11-19 round 7 F3, the chronicle page of the Imperial Pillars. Generated by gen_chronicle.py; edit the generator, not this file.

# Page body of the 编年史 tab. Used from organization_panel in panels/organization/oe_byz_empire_pillars.gui (the tab
# button and the include are written by gen_r6_aui.py). One row per historical main line, in historical order.
# Texts with a tooltip set alwaystransparent = no (text_single is transparent to the mouse by default).
template oe_chr_page {
    scrollarea = {
        size = { 100% 100% }
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
