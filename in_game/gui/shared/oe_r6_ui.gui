# NEW 2026-11-18 round 6 a-ui. Generated by gen_r6_aui.py; edit the generator, not this file.
# Shared visual theme library (v7.0 UI-1B) and Roman World shared widgets.
# Three verified EU5 1.4.9 civilization visual themes:
#   1. Imperial Purple-Gold  (Byzantium / Rome)   : oe_header_imperial_purple, oe_era_banner_purple
#   2. Great Yuan Vermilion  (Middle Kingdom)     : oe_header_yuan_vermilion,  oe_section_banner_yuan
#   3. Rus' White-Stone-Red  (Rus' & Steppe)      : oe_header_rus_kremlin,     oe_section_banner_rus

# ----------------------------------------------------------------------------- Theme Header Templates
template oe_header_imperial_purple {
    background = {
        using = bg_card_header_01_default
        blockoverride "header_color" {
            using = color_purple_02_texture
        }
        blockoverride "header_pattern" {
            using = bg_cloth_overlay_texture
            blend_mode = overlay
        }
        using = graphical_culture_pattern
    }
    using = bg_header_golden_frame
    using = bg_cabinet_card_frame
}

template oe_header_yuan_vermilion {
    background = {
        using = bg_card_header_01_default
        blockoverride "header_color" {
            using = color_dark_red_texture
        }
        blockoverride "header_pattern" {
            using = bg_cloth_overlay_texture
            blend_mode = overlay
        }
    }
    using = bg_header_golden_frame
    using = bg_cabinet_card_frame
}

template oe_header_rus_kremlin {
    background = {
        using = bg_card_header_01_default
        blockoverride "header_color" {
            using = color_red_texture
        }
        blockoverride "header_pattern" {
            using = bg_cloth_overlay_texture
            blend_mode = overlay
        }
    }
    using = bg_cabinet_card_frame
}

# ----------------------------------------------------------------------------- Section / Era Banner Templates
template oe_era_banner_purple {
    background = {
        using = color_dark_purple_texture
        alpha = 0.88
    }
    using = bg_header_golden_frame
}

template oe_section_banner_yuan {
    background = {
        using = color_dark_red_texture
        alpha = 0.88
    }
    using = bg_header_golden_frame
}

template oe_section_banner_rus {
    background = {
        using = color_dark_red_texture
        alpha = 0.78
    }
    using = bg_cabinet_card_frame
}

# ----------------------------------------------------------------------------- Shared Component Widgets
types oe_r6_ui_widgets {
    # Compact 2-line KPI tile (dark parchment + golden trim).
    type oe_kpi_tile = widget {
        layoutpolicy_horizontal = expanding
        size = { -1 50 }
        using = bg_dark_paper_card
        using = bg_header_golden_frame
        vbox = {
            size = { 100% 100% }
            margin = { 6 4 }
            spacing = 1
            block "kpi_label" {
                text_single = {
                    layoutpolicy_horizontal = expanding
                    align = hcenter|nobaseline
                    fontsize = 13
                    default_format = "#medium"
                    raw_text = ""
                }
            }
            block "kpi_value" {
                text_single = {
                    layoutpolicy_horizontal = expanding
                    align = hcenter|nobaseline
                    fontsize = 17
                    raw_text = ""
                }
            }
        }
    }

    # Great Yuan 2-column Vermilion-Gold dashboard tile (light paper + golden frame, multiline safe).
    type oe_kpi_tile_yuan = vbox {
        layoutpolicy_horizontal = expanding
        layoutstretchfactor_horizontal = 1
        margin = { 9 7 }
        spacing = 3
        using = bg_paper_card
        using = bg_header_golden_frame
        block "yuan_tile_header" {
            text_single = {
                layoutpolicy_horizontal = expanding
                fontsize = 13
                default_format = "#yellow_titles"
                raw_text = ""
            }
        }
        block "yuan_tile_body" {}
    }

    # Compact status badge pill.
    type oe_status_pill = widget {
        size = { 86 24 }
        using = bg_dark_paper_card
        using = bg_header_golden_frame
        block "pill_text" {
            text_single = {
                size = { 100% 100% }
                autoresize = no
                align = center|nobaseline
                fontsize = 13
                raw_text = ""
            }
        }
    }

    # O(1) horizontal progress bar with optional 2px golden threshold tick marks.
    type oe_threshold_bar = widget {
        layoutpolicy_horizontal = expanding
        size = { -1 14 }
        using = bg_header_golden_frame
        progressbar = {
            size = { 100% 100% }
            direction = horizontal
            block "bar_style" { using = progress_bar_goldish }
            block "bar_bounds" {
                min = 0
                max = 100
            }
            block "bar_value" {
                value = 0
            }
        }
        block "bar_ticks" {}
    }

    # Reusable situation tug-of-war / crisis meter block.
    type oe_sit_tug_bar = vbox {
        layoutpolicy_horizontal = expanding
        margin = { 10 8 }
        spacing = 5
        using = bg_dark_paper_card
        using = bg_header_golden_frame
        hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 6
            block "tug_left" {}
            expand = {}
            block "tug_center" {}
            expand = {}
            block "tug_right" {}
        }
        oe_threshold_bar = {
            blockoverride "bar_style" { block "tug_bar_style" { using = progress_bar_goldish } }
            blockoverride "bar_bounds" { block "tug_bar_bounds" { min = 0 max = 100 } }
            blockoverride "bar_value" { block "tug_bar_value" { value = 0 } }
            blockoverride "bar_ticks" { block "tug_bar_ticks" {} }
        }
        block "tug_footer" {}
    }

    # Standardized expandable end-conditions card for situation panels.
    type oe_sit_end_conditions = situation_card_expandable {
        blockoverride "header_button_onclick" {
            onclick = "[LateralView.Vars.Toggle('requirements_toggled')]"
        }
        blockoverride "header_text" {
            text = "END_REQUIREMENTS"
        }
        blockoverride "header_icon" {
            texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
        }
        blockoverride "bottom_content" {
            TooltipRequirementsList = {
                textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
            }
        }
        blockoverride "visible_hint" {}
        blockoverride "onaction_hint" {
            block "situation_panel_outcome_hint" {}
        }
        blockoverride "bottom_content_onclick" {
            visible = "[LateralView.Vars.Exists('requirements_toggled')]"
        }
        blockoverride "icon_replace_visible_yes" {
            visible = "[LateralView.Vars.Exists('requirements_toggled')]"
        }
        blockoverride "icon_replace_visible_not" {
            visible = "[Not(LateralView.Vars.Exists('requirements_toggled'))]"
        }
    }

    type oe_r6_tribute_card = card_common {
        visible = "[GetScriptedGui('oe_r6_player_is_byz').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        blockoverride "header_decor_templates" { using = oe_header_imperial_purple }
        blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
        blockoverride "common_header_text_full" { text_single = { text = "OE_R6_TRIBUTE_HEADER" fontsize = 20 } }
        blockoverride "common_bottom_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                margin = { 12 12 }
                datamodel = "[InternationalOrganizationsView.GetActions]"
                item = {
                    widget = {
                        # 停付岁币 only while an agreement runs.
                        visible = "[Or(EqualTo_string(GenericAction.GetKey, 'oe_ttb_buy_peace'),And(EqualTo_string(GenericAction.GetKey, 'oe_ttb_stop_peace'),GetScriptedGui('oe_r6_ttb_paying').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)))]"
                        layoutpolicy_horizontal = expanding
                        size = { -1 56 }
                        using = bg_paper_card
                        using = bg_cabinet_card_frame
                        button_regular_diamond = {
                            parentanchor = center
                            size = { 390 40 }
                            fontsize = 18
                            text = "[GenericAction.GetNameWithNoTooltip]"
                            tooltipwidget = { using = io_generic_action_button_tooltip }
                            visible = "[PdxGuiWidget.IsUberButtonVisible]"
                            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                            scripted_action_tooltip = {
                                click_type = left
                                click_mode = single
                                actor = "[InternationalOrganizationsView.GetPlayer]"
                                action_name = "[GenericAction.GetKey]"
                                parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                            }
                        }
                    }
                }
            }
        }
    }

    type oe_r6_grant_title_bar = vbox {
        visible = "[GetScriptedGui('oe_r6_player_is_byz').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetPlayer.MakeScope).End)]"
        layoutpolicy_horizontal = expanding
        margin = { 10 4 }
        spacing = 4
        widget = {
            layoutpolicy_horizontal = expanding
            size = { -1 56 }
            using = bg_paper_card
            using = bg_cabinet_card_frame
            datacontext = "[GetGenericAction('oe_tw_grant_title')]"
            button_regular_diamond = {
                parentanchor = center
                size = { 390 40 }
                fontsize = 18
                text = "[GenericAction.GetNameWithNoTooltip]"
                tooltipwidget = { using = io_generic_action_button_tooltip }
                visible = "[PdxGuiWidget.IsUberButtonVisible]"
                enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                scripted_action_tooltip = {
                    click_type = left
                    click_mode = single
                    actor = "[InternationalOrganizationsView.GetPlayer]"
                    action_name = "[GenericAction.GetKey]"
                    parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                }
            }
        }
        text_single = {
            layoutpolicy_horizontal = expanding
            multiline = yes
            autoresize = yes
            fontsize = 14
            default_format = "#color_light_gray"
            text = "OE_R6_GRANT_TITLE_HINT"
        }
    }
}
