# Live IO members, independent of the native special-status group catalogue.
template oe_pillars_special_theme_rosters {
    card_common = {
        margin = { 8 4 }
        visible = "[GetScriptedGui('oe_pillars_roster_naval_visible').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
        blockoverride "header_decor_templates" {
            using = bg_card_header_01_hre
            using = bg_cabinet_card_frame
        }
        blockoverride "common_header_icon_texture" {
            texture = "gfx/interface/icons/international_organizations/special_statuses/oe_pillars_naval_theme.dds"
            texture_density = 2
        }
        blockoverride "common_header_text_full" {
            text_single = {
                raw_text = "[ShowSpecialStatusName('oe_pillars_naval_theme')]  ·  [GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).ScriptValue('oe_pillars_roster_naval_count')|0]"
                fontsize = 17
            }
        }
        blockoverride "header_size" { size = { -1 38 } }
        blockoverride "common_bottom_content" {
            flowcontainer = {
                layoutpolicy_horizontal = expanding
                wrap_count = 3
                ignoreinvisible = yes
                spacing = 6
                datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetMembers]"
                item = {
                    widget = {
                        visible = "[GetScriptedGui('oe_pillars_roster_naval_member').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                        using = oe_pillars_country_card
                    }
                }
            }
        }
    }

    card_common = {
        margin = { 8 4 }
        visible = "[GetScriptedGui('oe_pillars_roster_administrative_visible').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End)]"
