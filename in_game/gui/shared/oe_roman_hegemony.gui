                                                                text = "OE_HEG_AFRICA_EXPEDITION_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_africa_expedition_done').IsSet]"
                                                            }
