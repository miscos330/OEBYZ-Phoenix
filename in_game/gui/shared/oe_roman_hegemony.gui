# Shared type library; the Roman World panel instantiates this page explicitly.
types oe_roman_hegemony_widgets {
    type oe_rw_hegemony_page = scrollarea {
        using = layoutpolicy_expanding
        # Also replace a stale contest selection immediately after any member ends it.
        visible = "[And(GetScriptedGui('oe_rw_hegemony_access').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.MakeScope).End),Or(InternationalOrganizationsView.Vars.HasValue('organizations','oe_hegemony'),And(InternationalOrganizationsView.Vars.HasValue('organizations','oe_roman_contest'),InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('oe_rw_contest_ended').IsSet)))]"
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
        scrollwidget = {
            vbox = {
                layoutpolicy_horizontal = expanding
                margin = { 12 12 }
                spacing = 12
                text_single = { text = "OE_HEG_ROMAN_ACTIONS_NOTICE" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                # NEW 2026-11-17 Roman Reconquest: summary card (fervour, ten regions, stages).
                oe_rr_card = {}
                # NEW r6 a-ui: tribute actions after the contest ended (the contest page is hidden then).
                oe_r6_tribute_card = {}
                card_common = {
                    blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                    blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                    blockoverride "common_header_text_full" { text_single = { text = "OE_RW_EGYPT" fontsize = 20 } }
                    blockoverride "common_bottom_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            margin = { 10 10 }
                            spacing = 8
                            text_single = { text = "OE_RW_EGYPT_DESC" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                            widget = {
                                name = "oe_rw_egypt_map"
                                layoutpolicy_horizontal = expanding
                                size = { -1 340 }
                                background = {
                                    texture = "gfx/interface/illustrations/international_organization_types/oe_rw_egypt_map.dds"
                                    spriteType = stretched
                                }
                                button = {
                                    name = "oe_rw_egypt_hit"
                                    ignore_layout = yes
                                    parentanchor = left|top widgetanchor = left|top
                                    position = { 3% 4% } size = { 94% 92% }
                                    alwaystransparent = no
                                    tooltip = "OE_RW_EGYPT_OPEN"
                                    onclick = "[InternationalOrganizationsView.Vars.Set('oe_hegemony_region','egypt')]"
                                }
                                # Drawn after the hit area. Country context follows ownership, not occupation.
                                widget = {
                                    name = "oe_rw_alexandria_owner"
                                    ignore_layout = yes
                                    parentanchor = right|bottom widgetanchor = right|bottom
                                    position = { -14 -14 } size = { 124 94 }
                                    datacontext = "[GetLocationByKey('alexandria').GetOwner]"
                                    visible = "[Country.IsValid]"
                                    using = bg_paper_card
                                    using = bg_cabinet_card_frame
                                    vbox = {
                                        size = { 100% 100% }
                                        margin = { 8 6 }
                                        spacing = 6
                                        text_single = { text = "OE_RW_ALEXANDRIA" fontsize = 16 layoutpolicy_horizontal = expanding }
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            expand = {}
                                            country_flag_small_plus = { size = { 72 48 } tooltip = "OE_RW_ALEXANDRIA_OWNER" }
                                            expand = {}
                                        }
                                    }
                                }
                                widget = {
                                    name = "oe_rw_egypt_action_panel"
                                    ignore_layout = yes
                                    parentanchor = left|top widgetanchor = left|top
                                    position = { 5% 6% } size = { 90% 88% }
                                    visible = "[InternationalOrganizationsView.Vars.HasValue('oe_hegemony_region','egypt')]"
                                    alwaystransparent = no
                                    using = bg_paper_card
                                    using = bg_cabinet_card_frame
                                    vbox = {
                                        size = { 100% 100% } margin = { 14 12 } spacing = 10
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            text_single = { text = "OE_RW_EGYPT_ACTIONS" fontsize = 20 }
                                            expand = {}
                                            button_regular = {
                                                size = { 84 32 } text = "OE_RW_REGION_CLOSE"
                                                onclick = "[InternationalOrganizationsView.Vars.Set('oe_hegemony_region','none')]"
                                            }
                                        }
                                        scrollarea = {
                                            using = layoutpolicy_expanding
                                            scrollbarpolicy_horizontal = always_off
                                            scrollbar_vertical = { using = Scrollbar_Vertical }
                                            scrollwidget = {
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding spacing = 8
                                                    text_single = { text = "OE_HEG_ACTIONS_HINT" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                                                    block "oe_rw_egypt_actions" {
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_plan_egypt')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_egypt_plan_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "OE_HEG_EGYPT_PLAN_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_egypt_plan_done').IsSet]"
                                                            }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_reclaim_syria')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_syria_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "OE_HEG_SYRIA_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_syria_done').IsSet]"
                                                            }
                                                            text_single = { text = "OE_HEG_SYRIA_PROGRESS" fontsize = 15 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_return_holy_land')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_jerusalem_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "OE_HEG_JERUSALEM_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_jerusalem_done').IsSet]"
                                                            }
                                                            text_single = { text = "OE_HEG_JERUSALEM_PROGRESS" fontsize = 15 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_egypt_campaign')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_egypt_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "OE_HEG_EGYPT_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_egypt_done').IsSet]"
                                                            }
                                                            text_single = { text = "OE_HEG_EGYPT_PROGRESS" fontsize = 15 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_invade_egypt')]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        # NEW 2026-11-17 conquest campaign phase 1 (gen_heg_campaigns.py): status, proclaim, pay, peace.
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            text_single = { text = "OE_HC_EGYPT_STATUS" fontsize = 15 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_hc_egypt_active').IsSet]" }
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_hc_egypt_declare')]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_hc_egypt_pay')]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_hc_egypt_peace')]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_triumph_egypt')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_triumph_egypt_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "oe_heg_triumph_egypt_done" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_triumph_egypt_done').IsSet]"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            text_single = { text = "OE_RW_EGYPT_HINT" fontsize = 16 layoutpolicy_horizontal = expanding }
                        }
                    }
                }
card_common = {
                    blockoverride "header_decor_templates" { using = bg_card_header_01_hre using = bg_cabinet_card_frame }
                    blockoverride "common_header_icon_texture" { texture = "gfx/interface/icons/international_organizations/oe_byz_roman_world.dds" }
                    blockoverride "common_header_text_full" { text_single = { text = "OE_RW_AFRICA" fontsize = 20 } }
                    blockoverride "common_bottom_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            margin = { 10 10 }
                            spacing = 8
                            text_single = { text = "OE_RW_AFRICA_DESC" fontsize = 17 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                            widget = {
                                name = "oe_rw_africa_map"
                                layoutpolicy_horizontal = expanding
                                size = { -1 340 }
                                background = {
                                    texture = "gfx/interface/illustrations/international_organization_types/oe_rw_africa_map.dds"
                                    spriteType = stretched
                                }
                                button = {
                                    name = "oe_rw_africa_hit"
                                    ignore_layout = yes
                                    parentanchor = left|top widgetanchor = left|top
                                    position = { 3% 4% } size = { 94% 92% }
                                    alwaystransparent = no
                                    tooltip = "OE_RW_AFRICA_OPEN"
                                    onclick = "[InternationalOrganizationsView.Vars.Set('oe_hegemony_region','africa')]"
                                }
                                # Drawn after the hit area. Country context follows ownership, not occupation.
                                widget = {
                                    name = "oe_rw_tunis_owner"
                                    ignore_layout = yes
                                    parentanchor = right|bottom widgetanchor = right|bottom
                                    position = { -14 -14 } size = { 124 94 }
                                    datacontext = "[GetLocationByKey('tunis').GetOwner]"
                                    visible = "[Country.IsValid]"
                                    using = bg_paper_card
                                    using = bg_cabinet_card_frame
                                    vbox = {
                                        size = { 100% 100% }
                                        margin = { 8 6 }
                                        spacing = 6
                                        text_single = { text = "OE_RW_TUNIS" fontsize = 16 layoutpolicy_horizontal = expanding }
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            expand = {}
                                            country_flag_small_plus = { size = { 72 48 } tooltip = "OE_RW_TUNIS_OWNER" }
                                            expand = {}
                                        }
                                    }
                                }
                                widget = {
                                    name = "oe_rw_africa_action_panel"
                                    ignore_layout = yes
                                    parentanchor = left|top widgetanchor = left|top
                                    position = { 5% 6% } size = { 90% 88% }
                                    visible = "[InternationalOrganizationsView.Vars.HasValue('oe_hegemony_region','africa')]"
                                    alwaystransparent = no
                                    using = bg_paper_card
                                    using = bg_cabinet_card_frame
                                    vbox = {
                                        size = { 100% 100% } margin = { 14 12 } spacing = 10
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            text_single = { text = "OE_RW_AFRICA_ACTIONS" fontsize = 20 }
                                            expand = {}
                                            button_regular = {
                                                size = { 84 32 } text = "OE_RW_REGION_CLOSE"
                                                onclick = "[InternationalOrganizationsView.Vars.Set('oe_hegemony_region','none')]"
                                            }
                                        }
                                        scrollarea = {
                                            using = layoutpolicy_expanding
                                            scrollbarpolicy_horizontal = always_off
                                            scrollbar_vertical = { using = Scrollbar_Vertical }
                                            scrollwidget = {
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding spacing = 8
                                                    text_single = { text = "OE_HEG_AFRICA_ACTIONS_HINT" fontsize = 16 multiline = yes autoresize = yes layoutpolicy_horizontal = expanding }
                                                    block "oe_rw_africa_actions" {
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_plan_africa')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_africa_plan_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
                                                                        click_type = left
                                                                        click_mode = single
                                                                        action_name = "[GenericAction.GetKey]"
                                                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                                                        parameter = { parameter_name = "recipient" parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]" }
                                                                    }
                                                                }
                                                            }
                                                            text_single = {
                                                                text = "OE_HEG_AFRICA_PLAN_DONE" fontsize = 17 layoutpolicy_horizontal = expanding
                                                                visible = "[GetCountry('BYZ').MakeScope.GetVariable('oe_heg_africa_plan_done').IsSet]"
                                                            }
                                                        }
                                                        vbox = {
                                                            layoutpolicy_horizontal = expanding spacing = 3
                                                            widget = {
                                                                layoutpolicy_horizontal = expanding size = { -1 44 }
                                                                datacontext = "[GetGenericAction('oe_heg_africa_expedition')]"
                                                                visible = "[Not(GetCountry('BYZ').MakeScope.GetVariable('oe_heg_africa_expedition_done').IsSet)]"
                                                                button_regular_diamond = {
                                                                    parentanchor = center
                                                                    size = { 360 40 }
                                                                    fontsize = 18
                                                                    text = "[GenericAction.GetNameWithNoTooltip]"
                                                                    tooltipwidget = { using = io_generic_action_button_tooltip }
                                                                    visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                                                    enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
                                                                    scripted_action_tooltip = {
