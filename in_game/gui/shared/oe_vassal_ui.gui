# NEW 2026-11-18 territory rework (UI). Generated by gen_territory_ui.py; edit the generator, not this file.

# NEW 2026-11-22 v13.6 W1: Scroll-free vassals body embedded directly into the Overview tab (no nested scrollarea, no trailing expand).
template oe_vassal_ui_body {
    vbox = {
        layoutpolicy_horizontal = expanding
        margin = { 8 6 }
        spacing = 6

            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 60 }
                using = bg_paper_card
                using = bg_cabinet_card_frame
                hbox = {
                    size = { 100% 100% }
                    margin = { 10 6 }
                    spacing = 2
                    widget = {
                        size = { 92 46 }
                        vbox = {
                            size = { 100% 100% }
                            text_single = { text = "OE_TV_SUM_COUNT" maximumsize = { 92 20 } elide = right fontsize = 14 default_format = "#medium" }
                            text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.MakeScope.ScriptValue('oe_tv_count')|0]" fontsize = 20 }
                        }
                    }
                    widget = {
                        size = { 92 46 }
                        vbox = {
                            size = { 100% 100% }
                            text_single = { text = "OE_TV_SUM_ALLY" maximumsize = { 92 20 } elide = right fontsize = 14 default_format = "#medium" }
                            text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.MakeScope.ScriptValue('oe_tv_ally_count')|0]" fontsize = 20 }
                        }
                    }
                    widget = {
                        size = { 92 46 }
                        vbox = {
                            size = { 100% 100% }
                            text_single = { text = "OE_TV_SUM_READY" maximumsize = { 92 20 } elide = right fontsize = 14 default_format = "#medium" }
                            text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.MakeScope.ScriptValue('oe_tv_ready_count')|0]" fontsize = 20 }
                        }
                    }
                    widget = {
                        size = { 92 46 }
                        vbox = {
                            size = { 100% 100% }
                            text_single = { text = "OE_TV_SUM_RESTLESS" maximumsize = { 92 20 } elide = right fontsize = 14 default_format = "#medium" }
                            text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.MakeScope.ScriptValue('oe_tv_restless_count')|0]" fontsize = 20 }
                        }
                    }
                    expand = {}
                }
            }
            text_single = {
                layoutpolicy_horizontal = expanding
                text = "OE_TV_LADDER"
                fontsize = 14
                multiline = yes
                autoresize = yes
                maximumsize = { 490 -1 }
                default_format = "#color_light_gray"
            }
            text_single = {
                layoutpolicy_horizontal = expanding
                visible = "[GetScriptedGui('oe_tv_empty').IsShown(GuiScope.SetRoot(InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.MakeScope).End)]"
                text = "OE_TV_EMPTY"
                fontsize = 15
                multiline = yes
                autoresize = yes
                maximumsize = { 490 -1 }
            }

            # One card per subject: who and what it is, then how it stands with the empire.
            vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 4
                datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetDiplomacy.GetSubjects]"
                item = {
                    widget = {
                        visible = "[GetScriptedGui('oe_tv_row').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                        layoutpolicy_horizontal = expanding
                        size = { -1 64 }
                        using = bg_paper_card
                        using = bg_cabinet_card_frame
                        vbox = {
                            size = { 100% 100% }
                            margin = { 8 4 }
                            spacing = 2
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 6
                                country_flag_small_plus = { size = { 28 21 } }
                                text_single = { autoresize = no size = { 164 24 } elide = right fontsize = 16 text = "[Country.GetNameWithNoTooltip]" tooltip = "[Country.GetName]" }
                                text_single = { autoresize = no size = { 140 24 } elide = right fontsize = 14 raw_text = "[Localize(Country.GetDiplomacy.GetSubjectType.GetNameKey)]" default_format = "#medium" }
                                expand = {}
                                text_single = { autoresize = no size = { 70 24 } elide = right fontsize = 14 raw_text = "[Country.Custom('OeTvAttitude')]" tooltip = "OE_TV_ATTITUDE_TT" }
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 6
                                text_single = { autoresize = no size = { 200 20 } elide = right fontsize = 13 raw_text = "#medium [Localize('OE_TV_RANK_LABEL')]#! [Country.Custom('OeTwRank')]  ·  [Country.Custom('OeTwTitleName')]" tooltip = "OE_TV_RANK_TT" }
                                text_single = { autoresize = no size = { 280 20 } elide = right fontsize = 13 raw_text = "[Country.Custom('OeTvStage')]" tooltip = "OE_TV_LADDER" }
                                expand = {}
                            }
                        }
                    }
                }
            }
    }
}

# Backward-compatible full-page wrapper (scrollarea around oe_vassal_ui_body + trailing expand).
template oe_vassal_ui_page {
    scrollarea = {
        size = { 100% 100% }
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
        scrollwidget = {
            vbox = {
                layoutpolicy_horizontal = expanding
                margin = { 8 6 }
                spacing = 6
                using = oe_vassal_ui_body
                expand = {}
            }
        }
    }
}
