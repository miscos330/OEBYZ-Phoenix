                on_action = "[OpenInternationalOrganizationView(GetUniqueInternationalOrganization('oe_byz_empire_pillars').Self)]"
            }
            action_tooltip = {
                click_type = right
                title = "OE_ALERT_RIGHT_DISMISS"
                clicksound = "UI_alert_discard"
                on_action = "[GetVariableSystem.Set('oe_alert_dismiss_exarch_disloyal', 'yes')]"
            }

            tooltipwidget = {
                ContextualTooltipType = {
                    blockoverride "title_icon" {
                        icon = {
                            using = tooltip_title_icon_size
                            texture = "gfx/interface/icons/alerts_icons/alert_annexing_disloyal.dds"
                        }
                    }
                    blockoverride "title_text" {
                        text = "OE_ALERT_EXARCH_DISLOYAL_TITLE"
                    }
                    blockoverride "concept_link" {
                        visible = no
                    }
                    blockoverride "tooltip_content" {
                        TooltipTextBlock = {
                            blockoverride "text" {
                                text = "OE_ALERT_EXARCH_DISLOYAL_DESC"
                            }
                        }
                    }
                }
            }
        }

        # 4. Yellow Alert: Maritime Silk Corridor Charter / Convoy Ready
        oe_top_alert_flag = {
            name = "oe_alert_btn_silk_node_open"
            using = yellow_alert
            visible = "[And(Not(GetVariableSystem.Exists('oe_alert_dismiss_silk_node_open')), GetScriptedGui('oe_alert_silk_node_open').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
            onrightclick = "[GetVariableSystem.Set('oe_alert_dismiss_silk_node_open', 'yes')]"

            blockoverride "oe_alert_icon" {
                texture = "gfx/interface/icons/flat_icons/trade_capacity.dds"
            }

            action_tooltip = {
                click_type = left
                title = "OE_ALERT_CTA_DECISIONS"
                on_action = "[OpenLateralViewWithParams('decisions', 'subtab = decisions')]"
            }
            action_tooltip = {
                click_type = right
                title = "OE_ALERT_RIGHT_DISMISS"
                clicksound = "UI_alert_discard"
                on_action = "[GetVariableSystem.Set('oe_alert_dismiss_silk_node_open', 'yes')]"
            }

            tooltipwidget = {
                ContextualTooltipType = {
                    blockoverride "title_icon" {
                        icon = {
                            using = tooltip_title_icon_size
                            texture = "gfx/interface/icons/flat_icons/trade_capacity.dds"
                        }
                    }
                    blockoverride "title_text" {
                        text = "OE_ALERT_SILK_OPEN_TITLE"
                    }
                    blockoverride "concept_link" {
                        visible = no
                    }
                    blockoverride "tooltip_content" {
                        TooltipTextBlock = {
                            blockoverride "text" {
                                text = "OE_ALERT_SILK_OPEN_DESC"
                            }
                        }
                    }
                }
            }
        }

        # 5. Green Alert: Overseas Factoria Envoy / Far Seas Charter Ready
        oe_top_alert_flag = {
            name = "oe_alert_btn_far_post_ready"
            using = green_alert
            visible = "[And(Not(GetVariableSystem.Exists('oe_alert_dismiss_far_post_ready')), GetScriptedGui('oe_alert_far_post_ready').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
            onrightclick = "[GetVariableSystem.Set('oe_alert_dismiss_far_post_ready', 'yes')]"

            blockoverride "oe_alert_icon" {
                texture = "gfx/interface/icons/alerts_icons/can_embrace_institution.dds"
            }

            action_tooltip = {
                click_type = left
                title = "OE_ALERT_CTA_DECISIONS"
                on_action = "[OpenLateralViewWithParams('decisions', 'subtab = decisions')]"
            }
            action_tooltip = {
                click_type = right
                title = "OE_ALERT_RIGHT_DISMISS"
                clicksound = "UI_alert_discard"
                on_action = "[GetVariableSystem.Set('oe_alert_dismiss_far_post_ready', 'yes')]"
            }

            tooltipwidget = {
                ContextualTooltipType = {
                    blockoverride "title_icon" {
                        icon = {
                            using = tooltip_title_icon_size
                            texture = "gfx/interface/icons/alerts_icons/can_embrace_institution.dds"
                        }
                    }
                    blockoverride "title_text" {
                        text = "OE_ALERT_FAR_POST_TITLE"
                    }
                    blockoverride "concept_link" {
                        visible = no
                    }
                    blockoverride "tooltip_content" {
                        TooltipTextBlock = {
                            blockoverride "text" {
                                text = "OE_ALERT_FAR_POST_DESC"
                            }
