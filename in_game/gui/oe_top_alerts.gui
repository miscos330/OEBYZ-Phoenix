            visible = "[And(Not(GetVariableSystem.Exists('oe_alert_dismiss_exarch_disloyal')), GetScriptedGui('oe_alert_exarch_disloyal').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
