# NEW 2026-11-21 v9.0 Route 2: O(1) Native-Style Top-Bar Alerts Strip. Generated by gen_top_alerts.py; edit the generator, not this file.
# Native-style O(1) Top-Bar Alerts Strip, mounted inside ingame_topbar.gui (gen_vanilla_overrides.py).
# Reuses EU5 1.4.9 red_alert / orange_alert / yellow_alert / green_alert banner templates & verified vanilla icons.
# Strict O(1) steady-state budget: 5 ScriptedGui.IsShown + 5 GetVariableSystem.Exists = 10 evals; 0 iterators.

types OeTopAlertsTypes {
    type oe_top_alert_flag = button {
        size = { 45 70 }
        using = snd_UI_alert_openAndCycle
        using = snd_UI_alert_hide
        rightclicksound = "UI_alert_discard"

        icon = {
            parentanchor = hcenter|vcenter
            position = { 0 -2 }
            size = { 30 30 }
            alwaystransparent = yes
            texture_density = 2
            block "oe_alert_icon" {}
            glow = {
                name = "drop_shadow"
                glow_radius = 3
                color = { 0.0 0.0 0.0 1.0 }
                alpha = 0.3
            }
        }
    }

    type oe_top_alerts_strip = hbox {
        name = "oe_top_alerts_strip"
        parentanchor = top|hcenter
        widgetanchor = top|hcenter
        position = { 70 40 }
        spacing = 2
        ignoreinvisible = yes
        datacontext = "[GetPlayer]"
        visible = "[And(And(Not(IsLobbyOpen), Not(IsTimeLineMode)), And(Not(IsLateralViewFullScreen), IsPlayerValid))]"

        using = Animation_Show_Hide_UI
        blockoverride "on_hide_ui" {
            position_y = -80
            alpha = 0
        }
        blockoverride "on_show_ui" {
            position_y = 40
            alpha = 1
        }

        # 1. Red Alert: High Imperial Entropy (>= 60)
        # BYZ/ROM opens Imperial Pillars (oe_entropy tab); Great Yuan / Russia / others toggle floating modal dashboard.
        oe_top_alert_flag = {
            name = "oe_alert_btn_high_entropy"
            using = red_alert
            visible = "[And(Not(GetVariableSystem.Exists('oe_alert_dismiss_high_entropy')), GetScriptedGui('oe_alert_high_entropy').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
            onrightclick = "[GetVariableSystem.Set('oe_alert_dismiss_high_entropy', 'yes')]"

            blockoverride "oe_alert_icon" {
                texture = "gfx/interface/icons/alerts_icons/alert_doom.dds"
            }

            action_tooltip = {
                click_type = left
                visible = "[And(GetScriptedGui('oe_ent_is_byz_or_rom').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetUniqueInternationalOrganization('oe_byz_empire_pillars').Exists)]"
                title = "OE_ALERT_CTA_ENTROPY_PILLARS"
                on_action = "[OpenInternationalOrganizationView(GetUniqueInternationalOrganization('oe_byz_empire_pillars').Self)]"
            }
            action_tooltip = {
                click_type = left
                visible = "[Not(And(GetScriptedGui('oe_ent_is_byz_or_rom').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetUniqueInternationalOrganization('oe_byz_empire_pillars').Exists))]"
                title = "OE_ALERT_CTA_ENTROPY_MODAL"
                on_action = "[GetVariableSystem.Toggle('oe_ent_modal_open')]"
            }
            action_tooltip = {
                click_type = right
                title = "OE_ALERT_RIGHT_DISMISS"
                clicksound = "UI_alert_discard"
                on_action = "[GetVariableSystem.Set('oe_alert_dismiss_high_entropy', 'yes')]"
            }

            tooltipwidget = {
                ContextualTooltipType = {
                    blockoverride "title_icon" {
                        icon = {
                            using = tooltip_title_icon_size
                            texture = "gfx/interface/icons/alerts_icons/alert_doom.dds"
                        }
                    }
                    blockoverride "title_text" {
                        text = "OE_ALERT_HIGH_ENTROPY_TITLE"
                    }
                    blockoverride "concept_link" {
                        visible = no
                    }
                    blockoverride "tooltip_content" {
                        TooltipTextBlock = {
                            blockoverride "text" {
                                text = "OE_ALERT_HIGH_ENTROPY_DESC"
                            }
                        }
                    }
                }
            }
        }

        # 2. Green Alert: Praetorian Prefecture / Classical Diocese Slot Available
        oe_top_alert_flag = {
            name = "oe_alert_btn_prf_available"
            using = green_alert
            visible = "[And(Not(GetVariableSystem.Exists('oe_alert_dismiss_prf_available')), GetScriptedGui('oe_alert_prf_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
            onrightclick = "[GetVariableSystem.Set('oe_alert_dismiss_prf_available', 'yes')]"

            blockoverride "oe_alert_icon" {
                texture = "gfx/interface/icons/alerts_icons/setup_a_law.dds"
            }

            action_tooltip = {
                click_type = left
                title = "OE_ALERT_CTA_PRF"
                on_action = "[OpenInternationalOrganizationView(GetUniqueInternationalOrganization('oe_byz_policy_org').Self)]"
            }
            action_tooltip = {
                click_type = right
