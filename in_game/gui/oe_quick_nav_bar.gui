# NEW 2026-11-21 v7.2 Wave 3 Package 4, Zero-Invasion Quick Nav HUD. Generated by gen_quick_hud.py; edit the generator, not this file.
# Floating collapsible Quick Nav Bar widget type, mounted inside ingame_topbar.gui (gen_vanilla_overrides.py).
# Pure O(1) client-side collapse state via GetVariableSystem('oe_qhud_collapsed').
types OeQuickNavBarTypes {
    type oe_quick_nav_bar = window {
        name = "oe_quick_nav_bar"
        parentanchor = bottom|left
        widgetanchor = bottom|left
        position = { 16 -96 }
        movable = yes
        resizable = no
        alwaystransparent = no
        allow_outside = yes
        datacontext = "[GetPlayer]"
        visible = "[And(Not(IsPauseMenuShown), And(And(And(Not(IsLobbyOpen), Not(IsTimeLineMode)), And(Not(IsLateralViewFullScreen), Not(LeftView.IsShown))), And(IsPlayerValid, GetScriptedGui('oe_qhud_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))))]"

        hbox = {
            set_parent_size_to_minimum = yes
            margin = { 6 4 }
            spacing = 4
            using = bg_dark_paper_card
            using = bg_header_golden_frame

            # Compact collapse / expand toggle button (always accessible, O(1) GetVariableSystem)
            button_regular = {
                name = "oe_qhud_toggle_btn"
                size = { 34 32 }
                onclick = "[GetVariableSystem.Toggle('oe_qhud_collapsed')]"
                tooltip = "OE_QHUD_TOGGLE_TT"
                icon = {
                    visible = "[Not(GetVariableSystem.Exists('oe_qhud_collapsed'))]"
                    parentanchor = center
                    size = { 18 18 }
                    texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                    using = button_regular_icon_color
                    alwaystransparent = yes
                }
                icon = {
                    visible = "[GetVariableSystem.Exists('oe_qhud_collapsed')]"
                    parentanchor = center
                    size = { 18 18 }
                    texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                    using = button_regular_icon_color
                    alwaystransparent = yes
                }
            }

            # Collapsed mini-label so the user knows what the badge restores
            button_regular = {
                name = "oe_qhud_restore_chip"
                visible = "[GetVariableSystem.Exists('oe_qhud_collapsed')]"
                size = { 82 32 }
                onclick = "[GetVariableSystem.Toggle('oe_qhud_collapsed')]"
                tooltip = "OE_QHUD_TOGGLE_TT"
                hbox = {
                    size = { 100% 100% }
                    margin = { 6 0 }
                    spacing = 4
                    icon = {
                        size = { 18 18 }
                        texture = "gfx/interface/icons/country_ranks/rank_empire.dds"
                        alwaystransparent = yes
                    }
                    text_single = {
                        layoutpolicy_horizontal = expanding
                        align = left|nobaseline
                        fontsize = 13
                        default_format = "#yellow_titles"
                        text = "OE_QHUD_BRAND"
                        alwaystransparent = yes
                    }
                }
            }

